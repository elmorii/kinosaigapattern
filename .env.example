# Copy this file to ".env" and fill in only what you use.
# The .env file is private: it is never published and never sent to visitors.

# Optional: override the product source folder (otherwise Documents\A To Copy is used)
# KINUSAIGA_SOURCE_ROOT=C:\Users\YourName\Documents\A To Copy

# Google Sheet with columns product_id, payhip_link  (choose ONE method)
# 1) Published CSV link (File > Share > Publish to web > Comma-separated values)
# CHECKOUT_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?output=csv
# 2) Google Sheets API key (also set checkoutSheet.spreadsheetId in shop.config.json)
# GOOGLE_SHEETS_API_KEY=

# Optional AI alt-text generation during import (vision.enabled must be true)
# GEMINI_API_KEY=

# Optional automatic upload to Hostinger via FTP (npm run deploy)
# FTP_HOST=ftp.your-domain.com
# FTP_USER=
# FTP_PASSWORD=
# FTP_REMOTE_DIR=/public_html
# FTP_SECURE=true
