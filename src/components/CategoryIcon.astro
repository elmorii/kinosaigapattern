---
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 32, class: className = '' } = Astro.props;
---

<span class:list={['category-svg-icon', className]}>
  {/* 1. Animal Patterns */}
  {(name === 'animal-patterns' || name === 'animals') && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
      <path d="M6 9a2 2 0 1 0-4 0c0 3 2 5 5 5h1" />
      <path d="M18 9a2 2 0 1 1 4 0c0 3-2 5-5 5h-1" />
      <path d="M7 16c1 2 3 3 5 3s4-1 5-3" />
      <path d="M9 4.5 6 2M15 4.5 18 2" />
    </svg>
  )}

  {/* 2. Nature Patterns */}
  {(name === 'nature-patterns' || name === 'flowers-and-plants' || name === 'landscapes-and-sky') && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 7.5a4.5 4.5 0 1 1 4.5 4.5M12 7.5A4.5 4.5 0 1 0 7.5 12M12 7.5V3m4.5 9a4.5 4.5 0 1 1-4.5 4.5m4.5-4.5H21m-9 4.5a4.5 4.5 0 1 1-4.5-4.5m4.5 4.5V21m-4.5-9H3" />
      <circle cx="12" cy="12" r="2.5" />
    </svg>
  )}

  {/* 3. Vegetable Patterns */}
  {name === 'vegetable-patterns' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2v4" />
      <path d="M8 3c1 1.5 2 2.5 4 3" />
      <ellipse cx="12" cy="14" rx="8" ry="7" />
      <path d="M12 7c-2 2-3 4.5-3 7s1 5 3 7" />
      <path d="M12 7c2 2 3 4.5 3 7s-1 5-3 7" />
    </svg>
  )}

  {/* 4. Fruit Patterns */}
  {(name === 'fruit-patterns' || name === 'food-and-drink') && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2c0 2-1 3.5-3 4" />
      <path d="M12 2c1.5 0 3 1.5 3 3" />
      <path d="M12 6.5C10 4.5 7 5 5 7.5c-2.5 3-2.5 7.5 1 11.5 2.5 2.8 5 4 6 4s3.5-1.2 6-4c3.5-4 3.5-8.5 1-11.5-2-2.5-5-3-7-1Z" />
      <path d="M8.5 11.5h.01M15.5 11.5h.01M12 14h.01M10 16.5h.01M14 16.5h.01" stroke-width="2.2" />
    </svg>
  )}

  {/* 5. Insect Pattern */}
  {(name === 'insect-pattern' || name === 'insect-patterns' || name === 'insects-and-bugs') && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2v20M8 5a4 4 0 0 0-4 4c0 3 2 5 8 5M16 5a4 4 0 0 1 4 4c0 3-2 5-8 5" />
      <path d="M9 19a3 3 0 0 1-5-3c0-2 2-3 8-3M15 19a3 3 0 0 0 5-3c0-2-2-3-8-3" />
    </svg>
  )}

  {/* 6. Love Patterns */}
  {name === 'love-patterns' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
    </svg>
  )}

  {/* 7. Art Patterns */}
  {(name === 'art-patterns' || name === 'geometric-and-symbols') && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="13.5" cy="6.5" r=".5" fill="currentColor" />
      <circle cx="17.5" cy="10.5" r=".5" fill="currentColor" />
      <circle cx="8.5" cy="7.5" r=".5" fill="currentColor" />
      <circle cx="6.5" cy="12.5" r=".5" fill="currentColor" />
      <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z" />
    </svg>
  )}

  {/* 8. Season Patterns */}
  {(name === 'season-patterns' || name === 'seasonal-and-holiday') && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" />
      <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />
    </svg>
  )}

  {/* 9. Ordinary Object Patterns */}
  {(name === 'ordinary-object-patterns' || name === 'home-and-everyday-objects') && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M17 8h1a4 4 0 1 1 0 8h-1M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
      <line x1="6" y1="2" x2="6" y2="4" />
      <line x1="10" y1="2" x2="10" y2="4" />
      <line x1="14" y1="2" x2="14" y2="4" />
    </svg>
  )}

  {/* 10. Fantasy Patterns */}
  {(name === 'fantasy-patterns' || name === 'fantasy') && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z" />
    </svg>
  )}

  {/* 11. Architecture Patterns */}
  {name === 'architecture-patterns' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
      <polyline points="9 22 9 12 15 12 15 22" />
    </svg>
  )}
</span>

<style>
  .category-svg-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
</style>
