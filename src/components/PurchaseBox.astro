---
import type { Product } from '../lib/types.ts';
import { getShopConfig } from '../lib/catalog.ts';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const config = getShopConfig();
const isFree = product.type === 'free';
const hasCheckout = !isFree && product.checkout && product.checkout.approved && product.checkout.code && !product.checkout.code.startsWith('plan_');
const isDraft = product.status === 'draft';
---

<div class="purchase-box">
  {isDraft && (
    <div class="draft-notice">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: -2px; margin-right: 4px;">
        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
        <line x1="12" y1="9" x2="12" y2="13"></line>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg>
      <strong>Draft listing:</strong> {product.draftReasons.join(', ')}
    </div>
  )}

  <div class="price-row">
    <div class="price-val">
      {isFree ? (
        <div class="free-block">
          <span class="price-tag free">FREE</span>
          <span class="price-sub">Instant PDF Download</span>
        </div>
      ) : (
        <div class="paid-block">
          <span class="price-tag">${product.price !== null ? product.price.toFixed(2) : '—'}</span>
          <span class="price-currency">{product.currency || 'USD'}</span>
          <span class="price-sub">Instant Digital Download</span>
        </div>
      )}
    </div>
  </div>

  <div class="action-cta">
    {isFree ? (
      product.download ? (
        <>
          <!-- Free Pattern Trigger Button: Preserves exact appearance but opens popup -->
          <button
            type="button"
            class="btn btn-green cta-btn download-btn open-free-modal-btn"
            id={`open-free-modal-${product.id}`}
            aria-haspopup="dialog"
            aria-controls={`free-download-modal-${product.id}`}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: -3px; margin-right: 6px;">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download Free Pattern (PDF)
          </button>

          <!-- Free Download Welcome Popup Modal -->
          <div
            id={`free-download-modal-${product.id}`}
            class="free-modal-overlay"
            role="dialog"
            aria-modal="true"
            aria-labelledby={`free-modal-title-${product.id}`}
            aria-describedby={`free-modal-desc-${product.id}`}
            hidden
          >
            <div class="free-modal-backdrop" data-close-modal></div>
            <div class="free-modal-container">
              <div class="free-modal-card">
                <button
                  type="button"
                  class="free-modal-close"
                  aria-label="Close modal"
                  data-close-modal
                >
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>

                <div class="free-modal-header">
                  <div class="free-modal-icon-wrap" aria-hidden="true">
                    <!-- Elegant gift / welcome icon -->
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 12 20 22 4 22 4 12"></polyline>
                      <rect x="2" y="7" width="20" height="5"></rect>
                      <line x1="12" y1="22" x2="12" y2="7"></line>
                      <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                      <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                    </svg>
                  </div>
                  <h2 id={`free-modal-title-${product.id}`} class="free-modal-title">
                    Welcome to Kinosaiga Pattern!
                  </h2>
                  <p class="free-modal-subtitle">Start your next fabric art piece today.</p>
                </div>

                <div id={`free-modal-desc-${product.id}`} class="free-modal-body">
                  <p>We're glad to share this free printable Kinusaiga template with you!</p>
                  <p>Our starter downloads let you test our layout quality and practice Japanese no-sew fabric tucking at home with zero cost.</p>
                  <p>Enjoy this free pattern anytime — and whenever you're ready for more subjects, browse our full original Kinusaiga collection.</p>
                  <p class="free-modal-signoff">Happy crafting!</p>
                </div>

                <div class="free-modal-footer">
                  <button
                    type="button"
                    class="btn btn-green free-modal-download-btn"
                    data-download-url={product.download.url}
                    data-download-name={product.download.fileName}
                    data-product-id={product.id}
                  >
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                      <polyline points="7 10 12 15 17 10"></polyline>
                      <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    <span>Download Free Pattern</span>
                  </button>

                  <p class="free-modal-note">Free download · No payment required</p>

                  <a href="/shop" class="free-modal-premium-link">
                    Explore Our Premium Patterns →
                  </a>

                  <div class="free-modal-error" style="display: none;" role="alert">
                    We encountered an issue downloading the file. Please refresh and try again.
                  </div>
                </div>
              </div>
            </div>
          </div>
        </>
      ) : (
        <button class="btn btn-secondary cta-btn" disabled>
          Download Currently Unavailable
        </button>
      )
    ) : hasCheckout ? (
      <div class="purchase-buttons-stack">
        <!-- In-Page Embedded Checkout Buy Button -->
        <a
          href={`https://payhip.com/buy?link=${product.checkout!.code}`}
          class="btn btn-green purchase-btn buy-now-btn"
          id={`buy-now-btn-${product.id}`}
          data-product-id={product.id}
          data-checkout-url={`https://payhip.com/buy?link=${product.checkout!.code}`}
          data-product-title={`${product.niche} Kinusaiga Pattern`}
        >
          Buy Now
        </a>

        <button
          type="button"
          class="purchase-btn add-to-cart-btn"
          id={`add-to-cart-btn-${product.id}`}
          data-product-id={product.id}
          data-product-title={product.title}
          data-product-price={product.price !== null ? product.price : 1.99}
          data-product-image={product.images[0]?.variants[0]?.src || '/favicon.png'}
          data-product-slug={product.slug}
          data-payhip-code={product.checkout!.code}
          data-checkout-url={product.checkout!.checkoutUrl}
        >
          <svg
            class="btn-cart-icon"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="8" cy="21" r="1"></circle>
            <circle cx="19" cy="21" r="1"></circle>
            <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
          </svg>
          <span class="btn-text">Add to Cart</span>
        </button>
      </div>
    ) : (
      <div class="soon-container">
        <button type="button" class="btn btn-soon cta-btn" disabled aria-disabled="true">
          <span>⏳</span> Soon...
        </button>
        <p class="soon-desc">
          In the future, our digital pattern collection will be available for purchase. Stay tuned!
        </p>
      </div>
    )}
  </div>

  <div class="trust-points">
    <div class="trust-item">
      <span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </span>
      <p><strong>Instant Access:</strong> Files available right after confirmation</p>
    </div>
    <div class="trust-item">
      <span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </span>
      <p><strong>Secure Checkout:</strong> Powered and delivered by Payhip</p>
    </div>
    <div class="trust-item">
      <span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
        </svg>
      </span>
      <p><strong>Digital Product:</strong> Printable templates for your home or shop printer</p>
    </div>
  </div>
</div>

<script>
  import { addToCart } from '../lib/cart.ts';

  function setupAddToCartButtons() {
    const cartBtns = document.querySelectorAll<HTMLButtonElement>('.add-to-cart-btn');

    cartBtns.forEach((btn) => {
      if (btn.dataset.cartBound === 'true') return;
      btn.dataset.cartBound = 'true';

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const id = btn.dataset.productId;
        const title = btn.dataset.productTitle;
        const price = parseFloat(btn.dataset.productPrice || '1.99');
        const image = btn.dataset.productImage || '/favicon.png';
        const slug = btn.dataset.productSlug || '';
        const payhipCode = btn.dataset.payhipCode || '';
        const checkoutUrl = btn.dataset.checkoutUrl || '';

        if (!id || !title) return;

        const result = addToCart({
          id,
          title,
          price,
          image,
          payhipCode,
          checkoutUrl,
          slug,
        });

        // Visual feedback on the button
        const textSpan = btn.querySelector('.btn-text');
        const origText = textSpan ? textSpan.textContent : 'Add to Cart';

        if (textSpan) {
          textSpan.textContent = result.alreadyExists ? 'Already in Cart' : 'Added to Cart!';
        }

        setTimeout(() => {
          if (textSpan) textSpan.textContent = origText;
        }, 1800);

        // Show small confirmation message under the navbar cart icon (do NOT open the right slide)
        const win = window as unknown as { showNavCartMessage?: (msg: string) => void };
        const msg = result.alreadyExists ? 'Already in cart' : 'Added to cart!';
        if (typeof win.showNavCartMessage === 'function') {
          win.showNavCartMessage(msg);
        } else {
          window.dispatchEvent(new CustomEvent('kinusaiga:cart-toast', {
            detail: { message: msg }
          }));
        }
      });
    });
  }

  function setupBuyNowButtons() {
    const buyBtns = document.querySelectorAll<HTMLElement>('.buy-now-btn');

    buyBtns.forEach((btn) => {
      if (btn.dataset.buyBound === 'true') return;
      btn.dataset.buyBound = 'true';

      btn.addEventListener('click', (e) => {
        const url = btn.dataset.checkoutUrl || btn.getAttribute('href');
        const title = btn.dataset.productTitle || 'Secure Digital Checkout';
        const productId = btn.dataset.productId;

        if (url) {
          const win = window as any;
          if (typeof win.openKinuCheckout === 'function') {
            e.preventDefault();
            e.stopPropagation();
            win.openKinuCheckout(url, title, productId);
          }
        }
      });
    });
  }

  // Handle instant UI update when purchase completes
  if (typeof window !== 'undefined' && !(window as any).__kinuPurchaseListenerBound) {
    (window as any).__kinuPurchaseListenerBound = true;
    window.addEventListener('kinusaiga:purchase-completed', (e: any) => {
      const purchasedIds: string[] = (e.detail && e.detail.productIds) || [];
      const addToCartBtns = document.querySelectorAll<HTMLButtonElement>('.add-to-cart-btn');
      addToCartBtns.forEach((btn) => {
        const pid = (btn.dataset.productId || '').toUpperCase().trim();
        if (purchasedIds.length === 0 || purchasedIds.map((id) => id.toUpperCase().trim()).includes(pid)) {
          btn.innerHTML = `
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:-2px; margin-right:4px;">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Purchased
          `;
          btn.disabled = true;
          btn.classList.add('is-purchased');
        }
      });
    });
  }

  setupAddToCartButtons();
  setupBuyNowButtons();
  document.addEventListener('astro:page-load', () => {
    setupAddToCartButtons();
    setupBuyNowButtons();
  });

  function setupFreeDownloadModals() {
    const openBtns = document.querySelectorAll<HTMLButtonElement>('.open-free-modal-btn');

    openBtns.forEach((openBtn) => {
      // Avoid duplicate initialization
      if (openBtn.dataset.modalInitialized === 'true') return;
      openBtn.dataset.modalInitialized = 'true';

      const modalId = openBtn.getAttribute('aria-controls');
      if (!modalId) return;
      const modal = document.getElementById(modalId);
      if (!modal) return;

      const closeElements = modal.querySelectorAll('[data-close-modal]');
      const downloadBtn = modal.querySelector<HTMLButtonElement>('.free-modal-download-btn');
      const errorDiv = modal.querySelector<HTMLDivElement>('.free-modal-error');

      let lastFocusedEl: HTMLElement | null = null;
      let isDownloading = false;

      function openModal() {
        lastFocusedEl = document.activeElement as HTMLElement;
        modal.hidden = false;
        // Trigger reflow for CSS transition
        void modal.offsetHeight;
        modal.classList.add('is-open');
        document.body.style.overflow = 'hidden';

        if (downloadBtn) {
          downloadBtn.focus();
        } else {
          const closeBtn = modal.querySelector<HTMLButtonElement>('.free-modal-close');
          closeBtn?.focus();
        }

        document.addEventListener('keydown', handleKeydown);
      }

      function closeModal() {
        modal.classList.remove('is-open');
        document.body.style.overflow = '';
        document.removeEventListener('keydown', handleKeydown);

        setTimeout(() => {
          modal.hidden = true;
          if (errorDiv) errorDiv.style.display = 'none';
          if (lastFocusedEl && typeof lastFocusedEl.focus === 'function') {
            lastFocusedEl.focus();
          }
        }, 220);
      }

      function handleKeydown(e: KeyboardEvent) {
        if (e.key === 'Escape') {
          e.preventDefault();
          closeModal();
          return;
        }

        if (e.key === 'Tab') {
          const focusables = modal.querySelectorAll<HTMLElement>(
            'button:not([disabled]), a[href]:not([disabled]), [tabindex]:not([tabindex="-1"])'
          );
          if (focusables.length === 0) return;
          const first = focusables[0];
          const last = focusables[focusables.length - 1];

          if (e.shiftKey) {
            if (document.activeElement === first) {
              e.preventDefault();
              last.focus();
            }
          } else {
            if (document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        }
      }

      openBtn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });

      closeElements.forEach((el) => {
        el.addEventListener('click', (e) => {
          e.preventDefault();
          closeModal();
        });
      });

      if (downloadBtn) {
        downloadBtn.addEventListener('click', (e) => {
          e.preventDefault();
          if (isDownloading) return;

          const url = downloadBtn.dataset.downloadUrl;
          const fileName = downloadBtn.dataset.downloadName || 'free-kinusaiga-pattern.pdf';

          if (!url) {
            if (errorDiv) {
              errorDiv.textContent = 'Pattern file is currently unavailable.';
              errorDiv.style.display = 'block';
            }
            return;
          }

          isDownloading = true;
          const originalContent = downloadBtn.innerHTML;
          downloadBtn.disabled = true;
          downloadBtn.innerHTML = `
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="spin-icon" aria-hidden="true">
              <line x1="12" y1="2" x2="12" y2="6"></line>
              <line x1="12" y1="18" x2="12" y2="22"></line>
              <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line>
              <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line>
              <line x1="2" y1="12" x2="6" y2="12"></line>
              <line x1="18" y1="12" x2="22" y2="12"></line>
              <line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line>
              <line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line>
            </svg>
            <span>Starting Download...</span>
          `;

          try {
            // Programmatic anchor click triggers the browser's native file download
            const link = document.createElement('a');
            link.href = url;
            link.download = fileName;
            link.style.display = 'none';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            // Close popup after initiating download
            setTimeout(() => {
              closeModal();
              setTimeout(() => {
                downloadBtn.innerHTML = originalContent;
                downloadBtn.disabled = false;
                isDownloading = false;
              }, 250);
            }, 600);
          } catch (err) {
            console.error('Download error:', err);
            downloadBtn.innerHTML = originalContent;
            downloadBtn.disabled = false;
            isDownloading = false;
            if (errorDiv) {
              errorDiv.textContent = 'Could not download the file. Please try again.';
              errorDiv.style.display = 'block';
            }
          }
        });
      }
    });
  }

  setupFreeDownloadModals();
  document.addEventListener('astro:page-load', setupFreeDownloadModals);
</script>

<style>
  .purchase-box {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    margin: 1.5rem 0;
  }
  .draft-notice {
    background-color: #fff3cd;
    color: #856404;
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    margin-bottom: 1rem;
    border: 1px solid #ffeeba;
  }
  .price-row {
    margin-bottom: 1.2rem;
  }
  .price-tag {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1;
  }
  .price-tag.free {
    color: var(--free-badge-text);
  }
  .price-currency {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-muted);
    margin-left: 0.2rem;
  }
  .price-sub {
    display: block;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-top: 0.3rem;
  }
  .action-cta {
    margin-bottom: 1.5rem;
  }
  .soon-container {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }
  .btn-soon {
    background-color: #f8fafc;
    color: #475569;
    border: 1.5px dashed #cbd5e1;
    cursor: not-allowed;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 1.1rem;
    font-weight: 700;
  }
  .soon-desc {
    font-size: 0.88rem;
    color: #64748b;
    line-height: 1.45;
    margin: 4px 0 0;
    text-align: center;
  }
  .purchase-buttons-stack {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }
  .purchase-btn,
  .cta-btn {
    width: 100%;
    min-height: 50px;
    padding: 0.85rem 1.75rem;
    box-sizing: border-box;
    font-size: 1rem;
    font-weight: 700;
    border-radius: var(--radius-pill);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    line-height: 1.3;
    border: 2px solid transparent;
    transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .buy-now-btn {
    background-color: var(--brand-blue);
    color: #ffffff;
    border-color: var(--brand-blue);
  }
  .buy-now-btn:hover {
    background-color: var(--brand-blue-hover);
    border-color: var(--brand-blue-hover);
    transform: translateY(-1px);
    box-shadow: 0 8px 20px -4px rgba(37, 99, 235, 0.4);
  }
  .buy-now-btn:active {
    transform: translateY(0);
  }
  .add-to-cart-btn {
    background-color: var(--brand-blue-soft);
    color: var(--brand-blue-hover);
    border-color: var(--brand-blue);
    gap: 8px;
  }
  .add-to-cart-btn:hover {
    background-color: #dbeafe;
    border-color: var(--brand-blue-hover);
    color: var(--brand-blue-active);
    transform: translateY(-1px);
    box-shadow: 0 6px 14px -4px rgba(37, 99, 235, 0.2);
  }
  .add-to-cart-btn:active {
    transform: translateY(0);
  }
  .btn-cart-icon {
    flex-shrink: 0;
    stroke: currentColor;
    color: currentColor;
  }
  .download-btn {
    background-color: var(--brand-blue);
    color: #ffffff;
    border-color: var(--brand-blue);
  }
  .download-btn:hover {
    background-color: var(--brand-blue-hover);
    border-color: var(--brand-blue-hover);
    transform: translateY(-1px);
    box-shadow: 0 8px 20px -4px rgba(37, 99, 235, 0.35);
  }
  .trust-points {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .trust-item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.4;
  }
  .trust-item strong {
    color: var(--text-main);
  }

  /* Free Download Welcome Popup Modal */
  .free-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.22s ease, visibility 0.22s ease;
  }
  .free-modal-overlay:not([hidden]) {
    visibility: visible;
  }
  .free-modal-overlay.is-open {
    opacity: 1;
  }
