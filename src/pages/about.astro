import { getShopConfig } from '../lib/catalog.ts';

const config = getShopConfig();
const siteUrl = (config.shop.siteUrl || 'https://www.your-domain.com').replace(/\/$/, '');
const pageUrl = `${siteUrl}/about`;

const aboutSchema = [
