    name: 'Kinosaiga Pattern',
    url: siteUrl,
    logo: `${siteUrl}/favicon.png`,
    description: 'Digital pattern studio providing printable Kinusaiga patterns for no-sew Japanese fabric art.',
    sameAs: [siteUrl],
    knowsAbout: [
      'Kinusaiga',
      'Japanese Fabric Art',
      'No-Sew Textile Craft',
      'Printable Fabric Templates',
      'Kimekomi Technique',
      'Kimono Silk Recycling',
    ],
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      url: `${siteUrl}/contact`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is Kinusaiga fabric art?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Kinusaiga (絹絵) is a traditional Japanese art form created by tucking small pieces of fabric into grooves cut into a soft base board, creating intricate, textured pictorial art without needles or sewing.',
        },
      },
      {
        '@type': 'Question',
        name: 'What formats are the printable patterns delivered in?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'All patterns are delivered as instant digital downloads in vector PDF and high-resolution PNG formats, pre-scaled to standard frame dimensions and 100% actual print size.',
        },
      },
      {
        '@type': 'Question',
        name: 'Who creates the Kinusaiga patterns at this studio?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Our digital templates are prepared by Kinosaiga Pattern Studio in printable PDF and PNG formats sized for standard home printers.',
        },
      },
      {
        '@type': 'Question',
        name: 'Are these patterns suitable for absolute beginners?',
