    inLanguage: 'en-US',
    datePublished: '2026-11-05T00:00:00Z',
    dateModified: '2026-11-09T00:00:00Z',
    author: {
      '@type': 'Organization',
      '@id': `${siteUrl}/#author`,
      name: 'Kinosaiga Pattern Studio',
      url: pageUrl,
    },
    isPartOf: {
      '@type': 'WebSite',
      name: 'Kinosaiga Pattern',
      url: siteUrl,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${siteUrl}/#author`,
    name: 'Kinosaiga Pattern Studio',
    url: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: siteUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'About Us',
        item: pageUrl,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
