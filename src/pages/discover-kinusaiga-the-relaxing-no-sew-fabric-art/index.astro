---
import Layout from '../../layouts/Layout.astro';
import { getShopConfig } from '../../lib/catalog.ts';

const config = getShopConfig();
const siteUrl = config.shop.siteUrl || 'https://kinosaigapattern.com';
const BRAND_NAME = 'Kinosaiga Pattern';

const canonicalUrl = `${siteUrl}/discover-kinusaiga-the-relaxing-no-sew-fabric-art/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${canonicalUrl}#article`,
      isPartOf: {
        '@type': 'WebPage',
        '@id': canonicalUrl,
        url: canonicalUrl,
        name: 'Discover Kinusaiga: The Relaxing, No-Sew Fabric Art',
      },
      headline: 'Discover Kinusaiga: The Relaxing, No-Sew Fabric Art',
      description: 'Welcome to the world of Kinusaiga art! It’s the ultimate relaxing, no-sew craft that lets you turn beautiful fabric and scored foam into framed wall decor.',
      url: canonicalUrl,
      datePublished: '2024-07-31T15:48:44-06:00',
      dateModified: '2026-11-09T00:00:00Z',
      author: {
        '@type': 'Person',
        name: 'Byrdie Larsen',
        url: `${siteUrl}/about`,
      },
      publisher: {
        '@type': 'Organization',
        name: BRAND_NAME,
        url: siteUrl,
        logo: {
          '@type': 'ImageObject',
          url: `${siteUrl}/favicon.png`,
        },
      },
      image: `${siteUrl}/images/tutorials/discover-kinusaiga/hero-sunrise-kit.jpg`,
      articleSection: 'Fun & Easy Crafts',
      keywords: 'kinusaiga, no-sew fabric art, kinusaiga tutorial, japanese fabric craft, fabric tucking craft, foam board craft',
    },
    {
      '@type': 'HowTo',
      '@id': `${canonicalUrl}#howto`,
      name: 'Kinusaiga Tutorial: How to Make No-Sew Fabric Wall Art',
      description: 'Step-by-step tutorial on scoring foam board, cutting fabric swatches, tucking edges into slits, and mounting your finished textile artwork in a frame.',
      totalTime: 'PT2H',
      tool: [
        { '@type': 'HowToTool', name: 'X-Acto or precision craft knife' },
        { '@type': 'HowToTool', name: 'Seam ripper or blunt tucking stylus' },
        { '@type': 'HowToTool', name: 'Fabric scissors' },
        { '@type': 'HowToTool', name: 'All-purpose craft glue or hot glue' },
      ],
      supply: [
        { '@type': 'HowToSupply', name: '1-inch rigid insulation foam board (XPS)' },
        { '@type': 'HowToSupply', name: 'Double-sided adhesive sheet' },
        { '@type': 'HowToSupply', name: 'Printed design or sticker template' },
        { '@type': 'HowToSupply', name: 'Assorted woven fabric scraps (cotton or silk)' },
        { '@type': 'HowToSupply', name: 'Custom wooden display frame & backer board' },
      ],
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Score the Foam',
          text: 'Use an X-Acto knife to cut along the lines on your sticker template at a depth of 1/4 inch to create fabric slits. If you hit a hard spot, use a gentle sawing motion.',
          image: `${siteUrl}/images/tutorials/discover-kinusaiga/kinusaiga-score-design.jpg`,
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Cut and Tuck Fabric',
          text: 'Peel paper backing from a section. Cut fabric roughly 1/4 inch larger than the shape. Center fabric and use the flat back of a seam ripper to gently pull and tuck edges into slits. Trim excess flush with scissors.',
          image: `${siteUrl}/images/tutorials/discover-kinusaiga/kinusaiga-first-tuck.jpg`,
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'Frame It',
          text: 'Apply glue to the sides of the foam board and wrap edge fabric around. Press the wooden frame down over the artwork for a snug fit. Flip over and glue the backer board with sawtooth hanger.',
          image: `${siteUrl}/images/tutorials/discover-kinusaiga/kinusaiga-fit-frame.jpg`,
        },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: siteUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Learn',
          item: `${siteUrl}/learn/how-to-make-kinusaiga`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Discover Kinusaiga',
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---

<Layout
  title="Discover Kinusaiga: The Relaxing, No-Sew Fabric Art"
  description="Welcome to the world of Kinusaiga art! It’s the ultimate relaxing, no sew craft that lets you turn beautiful fabric and scored foam into framed wall decor."
  canonical={canonicalUrl}
  ogImage={`${siteUrl}/images/tutorials/discover-kinusaiga/hero-sunrise-kit.jpg`}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <div class="tutorial-page-wrapper">
    <!-- Breadcrumb Bar -->
    <div class="breadcrumb-container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/" class="crumb-link">Home</a>
        <span class="crumb-sep">/</span>
        <a href="/learn/how-to-make-kinusaiga" class="crumb-link">Learn</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current">Discover Kinusaiga: The Relaxing, No-Sew Fabric Art</span>
      </nav>
    </div>

    <!-- Article Hero Header -->
    <header class="article-hero">
      <div class="container hero-inner">
        <div class="hero-badge-wrap">
          <span class="hero-category-badge">Fun & Easy Crafts</span>
          <span class="hero-badge-dot">•</span>
          <span class="hero-format-badge">Kinusaiga Tutorial</span>
        </div>

        <h1 class="article-title">Discover Kinusaiga: The Relaxing, No-Sew Fabric Art</h1>

        <div class="article-byline">
          <div class="author-info">
            <span class="byline-label">By</span>
            <span class="author-name">Byrdie Larsen</span>
          </div>
          <span class="byline-sep">•</span>
          <time datetime="2024-07-31" class="publish-date">Published July 31, 2024</time>
          <span class="byline-sep">•</span>
          <span class="update-date">Updated Nov 9, 2026</span>
          <span class="byline-sep">•</span>
          <span class="read-time">8 min read</span>
        </div>

        <div class="hero-lead-box">
          <p class="hero-lead-text">
            <strong>Welcome to the world of Kinusaiga art!</strong> It’s the ultimate relaxing, no-sew craft that lets you turn beautiful fabric and scored foam into framed wall decor.
          </p>
          <p class="hero-sublead-text">
            If you've been looking for a cozy project to help you unwind after a long day, get lost in a good creative rhythm, and make something gorgeous for your home, Kinusaiga is about to become your new favorite passion.
          </p>
        </div>

        <div class="hero-image-figure">
          <img
            src="/images/tutorials/discover-kinusaiga/hero-sunrise-kit.jpg"
            alt="Sunrise Kinusaiga Pattern and Framed Textile Artwork Kit"
            class="hero-featured-img"
            loading="eager"
            width="1024"
            height="1024"
          />
          <figcaption class="hero-caption">
            Sunrise Kinusaiga Pattern: Handcrafted Japanese-style textile art created with tucked fabric scraps and scored foam.
          </figcaption>
        </div>
      </div>
    </header>

    <!-- Main Tutorial Content -->
    <main class="container article-container">
      <article class="article-content">
        <!-- Section 1: What is Kinusaiga? -->
        <section class="content-section" id="what-is-kinusaiga">
          <h2 class="section-heading">What Exactly is Kinusaiga?</h2>
          <p>
            <strong>Kinusaiga</strong> (pronounced <em>kee-noo-sigh-gah</em>) is a traditional Japanese art form created in the 1980s by Japanese artist Maeno Takashi. Originally, Japanese crafters used small pieces of vintage silk saved from antique kimonos to compose detailed, mosaic-like picture panels.
          </p>
          <p>
            Instead of sewing pieces together with needles or thread, the edges of each fabric swatch are gently tucked into pre-cut grooves on a cushioned base. The result is a raised, 3D piece of artwork that looks just like a handmade quilt panel inside a frame!
          </p>

          <div class="benefits-grid">
            <div class="benefit-card">
              <div class="benefit-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                </svg>
              </div>
              <h3 class="benefit-title">Zero Sewing Required</h3>
              <p class="benefit-desc">No machines, no bobbin winding, no needles, and no pricked fingers. Perfect for crafters of all skill levels.</p>
            </div>

            <div class="benefit-card">
              <div class="benefit-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
                </svg>
              </div>
              <h3 class="benefit-title">Deeply Calming & Therapeutic</h3>
              <p class="benefit-desc">Tucking smooth fabric into soft grooves is a deeply satisfying, peaceful process. An easy way to step away from screens and enjoy true "me-time."</p>
            </div>

            <div class="benefit-card">
              <div class="benefit-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="23 4 23 10 17 10"></polyline>
                  <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                </svg>
              </div>
              <h3 class="benefit-title">No Mistakes You Can't Fix</h3>
              <p class="benefit-desc">If a fabric placement isn't quite where you want it, simply lift the edge, adjust, and tuck it back in. It is completely stress-free.</p>
            </div>

            <div class="benefit-card">
              <div class="benefit-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <h3 class="benefit-title">Instant Gratification</h3>
              <p class="benefit-desc">You don't have to wait months to finish a traditional quilt. A 6×6 Kinusaiga panel comes together in just a couple of relaxing hours!</p>
            </div>
          </div>
        </section>

        <!-- Section 2: Kinusaiga Supplies & Tools -->
        <section class="content-section" id="supplies">
          <h2 class="section-heading">Kinusaiga Supplies & Tools</h2>
          <p>
            You only need a few straightforward household crafting supplies to make your own Kinusaiga artwork at home.
          </p>

          <div class="supplies-showcase-grid">
            <div class="showcase-card">
              <img
                src="/images/tutorials/discover-kinusaiga/kinusaiga-supplies.jpg"
                alt="Kinusaiga craft supplies including foam board, fabric scraps, template, and wooden frame"
                class="showcase-img"
                loading="lazy"
                width="640"
                height="640"
              />
              <div class="showcase-content">
                <h3 class="showcase-title">Essential Supplies</h3>
                <ul class="styled-checklist">
                  <li><strong>Foam Base:</strong> 1-inch or 1/2-inch rigid XPS insulation foam board</li>
                  <li><strong>Adhesive:</strong> Double-sided adhesive sheet or spray adhesive</li>
                  <li><strong>Pattern:</strong> Printable design template (scale 100% PDF)</li>
                  <li><strong>Fabric:</strong> Assorted woven cotton scraps or silk remnants</li>
                  <li><strong>Frame:</strong> Custom wooden display frame & backer board</li>
                </ul>
              </div>
            </div>

            <div class="showcase-card">
              <img
                src="/images/tutorials/discover-kinusaiga/kinusaiga-tools.jpg"
                alt="Kinusaiga tools: craft knife, seam ripper stylus, scissors, and craft glue"
                class="showcase-img"
                loading="lazy"
                width="640"
                height="640"
              />
              <div class="showcase-content">
                <h3 class="showcase-title">Basic Tools</h3>
                <ul class="styled-checklist">
                  <li><strong>X-Acto Knife:</strong> Precision craft blade for scoring grooves</li>
                  <li><strong>Seam Ripper / Stylus:</strong> Flat back tool for tucking fabric</li>
                  <li><strong>Craft Scissors:</strong> Fine fabric scissors for flush trimming</li>
                  <li><strong>All-Purpose Glue:</strong> For sealing edges and attaching backing</li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        <!-- Section 3: Step-by-Step Tutorial -->
        <section class="content-section" id="tutorial">
          <div class="tutorial-header-block">
            <span class="tutorial-pretitle">Hands-On Guide</span>
            <h2 class="section-heading">Kinusaiga Tutorial: Step-by-Step</h2>
            <p>Follow along with our complete photo tutorial to create your own Sunrise Kinusaiga piece.</p>
          </div>

          <!-- Step 1: Score -->
          <div class="tutorial-step-card" id="step-score">
            <div class="step-num-badge">Step 1</div>
            <div class="step-card-body">
              <h3 class="step-card-title">Score the Design into Foam</h3>
              <p>
                Use an X-Acto knife to slowly cut along the lines on your sticker or transferred template. Aim for a depth of <strong>1/4″</strong> to create your fabric slits.
              </p>
              <p>
                If you hit a hard spot in the foam, use a gentle sawing motion to clear it, then continue with a slow, smooth cut. Go slow and take your time around each contour.
              </p>
              <div class="step-img-box">
                <img
                  src="/images/tutorials/discover-kinusaiga/kinusaiga-score-design.jpg"
                  alt="Scoring lines into foam board using a precision craft knife"
                  class="step-photo"
                  loading="lazy"
                  width="640"
                  height="640"
                />
                <span class="step-img-caption">Cut smoothly along every pattern line to a depth of approximately 1/4 inch.</span>
              </div>
            </div>
          </div>

          <!-- Step 2: Cut and Tuck -->
          <div class="tutorial-step-card" id="step-cut-and-tuck">
            <div class="step-num-badge">Step 2</div>
            <div class="step-card-body">
              <h3 class="step-card-title">Cut and Tuck the Fabric</h3>
              <div class="substep-list">
                <div class="substep-item">
                  <span class="substep-bullet">1</span>
                  <p>Start with any individual section and carefully peel away the paper backing from the adhesive foam board.</p>
                </div>
                <div class="substep-item">
                  <span class="substep-bullet">2</span>
                  <p>
                    Cut a piece of fabric roughly <strong>1/4″ larger</strong> than the shape of that section. If filling an outer edge piece, leave the outer edge at least <strong>1/2″ long</strong> so it can wrap around the side.
                  </p>
                </div>
                <div class="step-img-box">
                  <img
                    src="/images/tutorials/discover-kinusaiga/kinusaiga-fabric-placement.jpg"
                    alt="Placing cut fabric over the peeled section of foam board"
                    class="step-photo"
                    loading="lazy"
                    width="640"
                    height="640"
                  />
                  <span class="step-img-caption">Center the fabric piece over the section, leaving a 1/4-inch margin on all sides.</span>
                </div>

                <div class="substep-item">
                  <span class="substep-bullet">3</span>
                  <p>
                    Center your cut fabric and rub it down gently onto the adhesive. Using the flat backside of the seam ripper or blunt stylus, gently press the fabric into the scored slits. <strong>Always pull the seam ripper as you tuck—NEVER push the fabric forcefully.</strong>
                  </p>
                </div>
                <div class="step-img-box">
                  <img
                    src="/images/tutorials/discover-kinusaiga/kinusaiga-first-tuck.jpg"
                    alt="Gently tucking fabric edges into scored slits using a seam ripper"
                    class="step-photo"
                    loading="lazy"
                    width="640"
                    height="640"
                  />
                  <span class="step-img-caption">Pull the tool gently along the slit to anchor the fabric into the foam.</span>
                </div>

                <div class="substep-item">
                  <span class="substep-bullet">4</span>
                  <p>
                    Once the fabric is anchored in, lay your scissors completely flat against the foam board and cut as close to the board as possible to trim away the bulk of the excess fabric.
                  </p>
                </div>
                <div class="step-img-box">
                  <img
                    src="/images/tutorials/discover-kinusaiga/kinusaiga-trim-excess-fabric.jpg"
                    alt="Trimming excess fabric flat against the foam board with scissors"
                    class="step-photo"
                    loading="lazy"
                    width="640"
                    height="640"
                  />
                  <span class="step-img-caption">Trim excess fabric flush against the foam board surface.</span>
                </div>

                <div class="substep-item">
                  <span class="substep-bullet">5</span>
                  <p>
                    Finish tucking the remaining raw edges cleanly into the slit. Pull in different directions to get a crisp, clean seam. Repeat for each neighboring section.
                  </p>
                </div>

                <!-- Gallery of tucking progression -->
                <div class="tucking-progression-grid">
                  <figure class="progression-item">
                    <img
                      src="/images/tutorials/discover-kinusaiga/kinusaiga-relief-cuts.jpg"
                      alt="Relief cuts on sharp curves"
                      class="step-photo"
                      loading="lazy"
                      width="640"
                      height="640"
                    />
                    <figcaption>Making relief snips on curves to help fabric lie smooth.</figcaption>
                  </figure>

                  <figure class="progression-item">
                    <img
                      src="/images/tutorials/discover-kinusaiga/kinusaiga-tucking-sun.jpg"
                      alt="Tucking the sunrise circle"
                      class="step-photo"
                      loading="lazy"
                      width="640"
                      height="640"
                    />
                    <figcaption>Tucking the vibrant central sun section.</figcaption>
                  </figure>

                  <figure class="progression-item">
                    <img
                      src="/images/tutorials/discover-kinusaiga/kinusaiga-final-tuck-all.jpg"
                      alt="All sections tucked cleanly into foam board"
                      class="step-photo"
                      loading="lazy"
                      width="640"
                      height="640"
                    />
                    <figcaption>All background rays and landscape shapes fully tucked.</figcaption>
                  </figure>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 3: Frame It -->
          <div class="tutorial-step-card" id="step-frame">
            <div class="step-num-badge">Step 3</div>
            <div class="step-card-body">
              <h3 class="step-card-title">Frame Your Artwork</h3>
              <div class="substep-list">
                <div class="substep-item">
                  <span class="substep-bullet">1</span>
                  <p>
                    Apply glue to the outer sides of the foam board. Smooth your fabric overhang down around the sides and trim any bulk excess. It does not need to be perfectly neat as the edges will be concealed inside the frame.
                  </p>
                </div>

                <div class="framing-prep-grid">
                  <figure class="progression-item">
                    <img
                      src="/images/tutorials/discover-kinusaiga/kinusaiga-trim-outer-edges.jpg"
                      alt="Trimming outer edge fabric"
                      class="step-photo"
                      loading="lazy"
                      width="640"
                      height="640"
                    />
                    <figcaption>Trimming outer fabric overhang.</figcaption>
                  </figure>

                  <figure class="progression-item">
                    <img
                      src="/images/tutorials/discover-kinusaiga/kinusaiga-finish-tucking-edges.jpg"
                      alt="Finishing outer tucking"
                      class="step-photo"
                      loading="lazy"
                      width="640"
                      height="640"
                    />
                    <figcaption>Final edge tucking around border.</figcaption>
                  </figure>

                  <figure class="progression-item">
                    <img
                      src="/images/tutorials/discover-kinusaiga/kinusaiga-glued-edges.jpg"
                      alt="Gluing fabric to the sides of foam"
                      class="step-photo"
                      loading="lazy"
                      width="640"
                      height="640"
                    />
                    <figcaption>Gluing fabric smoothly along the side perimeter.</figcaption>
                  </figure>
                </div>

                <div class="substep-item">
                  <span class="substep-bullet">2</span>
                  <p>
                    Place your finished artwork face-up on a clean table and gently press the wooden frame down over it for a snug, seamless fit.
                  </p>
                </div>
                <div class="step-img-box">
                  <img
                    src="/images/tutorials/discover-kinusaiga/kinusaiga-fit-frame.jpg"
                    alt="Pressing wooden frame down over finished Kinusaiga artwork"
                    class="step-photo"
                    loading="lazy"
                    width="640"
                    height="640"
                  />
                  <span class="step-img-caption">Press the frame evenly down around the foam core.</span>
                </div>

                <div class="substep-item">
                  <span class="substep-bullet">3</span>
                  <p>
                    Flip the frame and foam board over. Apply all-purpose glue or hot glue around the back perimeter. Double-check that your sawtooth hanger is oriented at the top of your design, then center the backing board onto the frame and allow the glue to cure thoroughly.
                  </p>
                </div>

                <div class="framing-finish-grid">
                  <figure class="progression-item">
                    <img
                      src="/images/tutorials/discover-kinusaiga/kinusaiga-frame-glue-up.jpg"
                      alt="Applying glue to back of frame and foam"
                      class="step-photo"
                      loading="lazy"
                      width="640"
                      height="640"
                    />
                    <figcaption>Applying adhesive along the back.</figcaption>
                  </figure>

                  <figure class="progression-item">
                    <img
                      src="/images/tutorials/discover-kinusaiga/kinusaiga-backer-board.jpg"
                      alt="Centering backer board with sawtooth hanger"
                      class="step-photo"
                      loading="lazy"
                      width="640"
                      height="640"
                    />
                    <figcaption>Securing backer board with hanger.</figcaption>
                  </figure>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Section 4: Tips and Tricks -->
        <section class="content-section" id="tips">
          <h2 class="section-heading">Pro Tips & Tricks for Kinusaiga Success</h2>

          <div class="tips-grid">
            <div class="tip-card">
              <h3 class="tip-title">Curves & Corners</h3>
              <p>Make small "relief snips" on sharp curves to help the fabric lay flat, and cut a small "V" notch in tight corners to remove fabric bulk before tucking.</p>
            </div>

            <div class="tip-card">
              <h3 class="tip-title">Fix a Peeking Board</h3>
              <p>If your fabric shifts and the white foam board peeks out, use your seam ripper or stylus to gently lift the edge, give it a strategic tug, and re-tuck it smoothly.</p>
            </div>

            <div class="tip-card">
              <h3 class="tip-title">Fabric Cut Too Short?</h3>
              <p>If a piece is cut too short, simply peel it off and cut a fresh piece. If the adhesive lifts with the fabric, a light dab of craft glue will securely reattach it.</p>
            </div>

            <div class="tip-card">
              <h3 class="tip-title">Crisp, Clean Seams</h3>
              <p>Rotate your board as you work so you can pull and tuck from varying comfortable angles to achieve perfectly uniform tension across every seam.</p>
            </div>

            <div class="tip-card">
              <h3 class="tip-title">Adhesive Backing Tip</h3>
              <p>If the adhesive starts lifting with the paper backing, lay the backing paper back down, burnish it firmly to re-bond, and peel again slowly at a low angle.</p>
            </div>
          </div>
        </section>

        <!-- Section 5: Finished Gallery -->
        <section class="content-section" id="gallery">
          <h2 class="section-heading">A Few Finished Pieces</h2>
          <p>Here is what the finished Kinusaiga artwork looks like once completed and mounted in a wooden frame:</p>

          <div class="finished-gallery-grid">
            <figure class="gallery-figure">
              <img
                src="/images/tutorials/discover-kinusaiga/kinusaiga-sunset-finished-full.jpg"
                alt="Finished Sunrise Kinusaiga textile wall decor in wooden frame"
                class="gallery-photo"
                loading="lazy"
                width="640"
                height="640"
              />
              <figcaption>Completed Sunrise Kinusaiga textile wall decor.</figcaption>
            </figure>

            <figure class="gallery-figure">
              <img
                src="/images/tutorials/discover-kinusaiga/kinusaiga-sunset-finished-angle.jpg"
                alt="Angled view of finished Sunrise Kinusaiga showing 3D quilted texture"
                class="gallery-photo"
                loading="lazy"
                width="640"
                height="640"
              />
              <figcaption>Angled perspective highlighting the tactile 3D relief texture.</figcaption>
