  <script>
    const slideshow = document.getElementById('hero-slideshow');
    if (slideshow) {
      const slides = slideshow.querySelectorAll('.slide-item');
      let currentIndex = 0;
      let timer: number | null = null;

      function loadSlideImg(slideEl: Element | null | undefined) {
        if (!slideEl) return;
        const img = slideEl.querySelector('img') as HTMLImageElement | null;
        if (img && img.dataset.src && !img.src) {
          img.src = img.dataset.src;
        }
      }

      function showSlide(idx: number) {
        slides[currentIndex]?.classList.remove('active');
        currentIndex = (idx + slides.length) % slides.length;
        const currentSlide = slides[currentIndex];
        loadSlideImg(currentSlide);
        currentSlide?.classList.add('active');

        // Preload next slide ahead of time for smooth transition
        const nextIdx = (currentIndex + 1) % slides.length;
        loadSlideImg(slides[nextIdx]);
      }

      function nextSlide() {
        showSlide(currentIndex + 1);
      }

      function prevSlide() {
        showSlide(currentIndex - 1);
      }

      function startTimer() {
        if (!timer) {
          timer = window.setInterval(nextSlide, 1800);
        }
      }

      function stopTimer() {
        if (timer) {
          window.clearInterval(timer);
          timer = null;
        }
      }

      // Preload second slide slightly after idle
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(() => loadSlideImg(slides[1]));
      } else {
        setTimeout(() => loadSlideImg(slides[1]), 800);
      }

      startTimer();

      // Touch swipe support (left/right swipe)
      let touchStartX = 0;
      let touchStartY = 0;

      slideshow.addEventListener('touchstart', (e: TouchEvent) => {
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
        stopTimer();
      }, { passive: true });

      slideshow.addEventListener('touchend', (e: TouchEvent) => {
        const touchEndX = e.changedTouches[0].screenX;
        const touchEndY = e.changedTouches[0].screenY;
        const diffX = touchEndX - touchStartX;
        const diffY = touchEndY - touchStartY;

        // Ensure horizontal intent
        if (Math.abs(diffX) > 35 && Math.abs(diffX) > Math.abs(diffY)) {
          if (diffX < 0) {
            nextSlide();
          } else {
            prevSlide();
          }
        }
        startTimer();
      }, { passive: true });
    }

    function checkBundleHash() {
      const hash = window.location.hash;
      if (hash === '#bundles') {
        const target = document.getElementById('bundles');
        if (target) {
          setTimeout(() => {
            target.scrollIntoView({ behavior: 'smooth' });
          }, 80);
        }
      }
    }

    checkBundleHash();
    window.addEventListener('hashchange', checkBundleHash);
  </script>
