---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getAllProducts, getFreeProducts, getShopConfig } from '../lib/catalog.ts';

const config = getShopConfig();
const allProducts = getAllProducts(config.catalog.showDraftsInDev);
const freeProducts = getFreeProducts();

const slideshowIds = [
  'K6', 'K14', 'K18', 'K20', 'K48', 'K22', 'K19', 'K27', 'K29', 'K15', 'K37', 'K21', 'K30', 'K52', 'K26'
];

const existingSlides = slideshowIds
  .map((id) => {
    const prod = allProducts.find((p) => p.id.toUpperCase() === id.toUpperCase());
    if (!prod) return null;
    const img = prod.images[0]?.variants.find((v) => v.width >= 800)?.src || prod.images[0]?.variants[0]?.src;
    return { src: img, alt: prod.title };
  })
  .filter(Boolean) as { src: string; alt: string }[];

const extraSlideImages = [
  '/images/hero-slides/extra-1.jpg',
  '/images/hero-slides/extra-2.jpg',
  '/images/hero-slides/extra-3.jpg',
  '/images/hero-slides/extra-4.jpg',
  '/images/hero-slides/extra-5.jpg',
  '/images/hero-slides/extra-6.jpg',
  '/images/hero-slides/extra-7.jpg',
  '/images/hero-slides/extra-8.jpg',
  '/images/hero-slides/extra-9.jpg',
  '/images/hero-slides/extra-10.jpg',
];

// Old slides: interleaved existing product slides and extra showcase slides
const oldSlides: { src: string; alt: string }[] = [];
let extraIdx = 0;
for (let i = 0; i < existingSlides.length; i++) {
  oldSlides.push(existingSlides[i]);
  if (extraIdx < extraSlideImages.length && (i % 2 === 0 || i === existingSlides.length - 1)) {
    oldSlides.push({
      src: extraSlideImages[extraIdx],
      alt: 'Kinusaiga Japanese fabric art artwork showcase',
    });
    extraIdx++;
  }
}
while (extraIdx < extraSlideImages.length) {
  oldSlides.push({
    src: extraSlideImages[extraIdx],
    alt: 'Kinusaiga Japanese fabric art artwork showcase',
  });
  extraIdx++;
}

// 16 New PNG slides from First Page Images folder
const newSlidePngs: { src: string; alt: string }[] = [
  { src: '/images/hero-slides/k80.png', alt: 'Penguin Kinusaiga Pattern Japanese fabric art template' },
  { src: '/images/hero-slides/34.png', alt: 'Kinusaiga fabric craft pattern artwork template' },
  { src: '/images/hero-slides/k84.png', alt: 'Wolf Kinusaiga Pattern Japanese textile craft' },
  { src: '/images/hero-slides/5.png', alt: 'Handmade Kinusaiga wall decor template' },
  { src: '/images/hero-slides/k89.png', alt: 'Waterfall Kinusaiga Pattern fabric art template' },
  { src: '/images/hero-slides/7.png', alt: 'Kinusaiga Japanese textile pattern design' },
  { src: '/images/hero-slides/k92.png', alt: 'Beach Kinusaiga Pattern craft art template' },
  { src: '/images/hero-slides/8.png', alt: 'Kinusaiga framed textile artwork showcase' },
  { src: '/images/hero-slides/k98.png', alt: 'Cucumber Kinusaiga Pattern printable template' },
  { src: '/images/hero-slides/8-copy.png', alt: 'Kinusaiga wall art pattern template' },
  { src: '/images/hero-slides/k101.png', alt: 'Grape Kinusaiga Pattern printable art template' },
  { src: '/images/hero-slides/e-1.png', alt: 'Japanese no-sew Kinusaiga craft design' },
  { src: '/images/hero-slides/k104.png', alt: 'Scorpion Kinusaiga Pattern printable template' },
  { src: '/images/hero-slides/e-2.png', alt: 'Handcrafted Kinusaiga textile template' },
  { src: '/images/hero-slides/k109.png', alt: 'Corn Kinusaiga Pattern Japanese textile template' },
  { src: '/images/hero-slides/k110.png', alt: 'Orange Kinusaiga Pattern fabric craft template' },
];

// Mix new PNGs with old slides (taking a new one, mixing with an old one, and completing all slides)
const interleavedSlides: { src: string; alt: string }[] = [];
let newI = 0;
let oldI = 0;
while (newI < newSlidePngs.length || oldI < oldSlides.length) {
  if (newI < newSlidePngs.length) {
    interleavedSlides.push(newSlidePngs[newI]);
    newI++;
  }
  if (oldI < oldSlides.length) {
    interleavedSlides.push(oldSlides[oldI]);
    oldI++;
  }
}

const freeShowcase = freeProducts.slice(0, 4);

// Select 8 diverse original paid products across 8 distinct niches
const paidProducts = allProducts.filter((p) => p.type === 'paid' && !p.isBundle && !(p.number >= 113 && p.number <= 119));
const distinctNiches = [...new Set(paidProducts.map((p) => p.niche))].sort(() => Math.random() - 0.5);
const featuredPaidProducts = distinctNiches
  .slice(0, 8)
  .map((niche) => paidProducts.find((p) => p.niche === niche))
  .filter(Boolean) as typeof paidProducts;

const bundleProducts = allProducts.filter((p) => p.isBundle || p.id.toUpperCase().startsWith('B') || (p.number >= 113 && p.number <= 119));

// Optimal SEO Meta Title strictly within 40-60 characters (57 chars)
const pageTitle = "Kinusaiga Patterns – Printable Art | Kinosaiga Pattern";

// Optimal SEO Meta Description strictly within 140-160 characters (154 chars)
const pageDescription = "Browse 110+ original printable Kinusaiga pattern templates for Japanese no-sew fabric art. Instant PDF and PNG downloads in up to 10 sizes plus free files.";

const pageKeywords = "Kinusaiga patterns, kinusaiga pattern, kinusaiga template, free kinusaiga patterns, japanese fabric art, printable patterns, no sew fabric art, kinusaiga patterns download";

// Full Schema.org Knowledge Graph for Homepage GEO & AI Search Optimization
const siteUrl = (config.shop.siteUrl || 'https://kinosaigapattern.com').replace(/\/$/, '');
const featuredForSchema = allProducts.slice(0, 12);

const homeSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    url: siteUrl,
    name: 'Kinosaiga Pattern',
    alternateName: 'Kinusaiga Patterns',
    description: 'Printable Kinusaiga patterns and original no-sew Japanese fabric art templates in PDF and PNG',
    inLanguage: 'en-US',
    datePublished: '2026-11-05T00:00:00Z',
    dateModified: '2026-11-22T00:00:00Z',
    author: {
      '@type': 'Organization',
      '@id': `${siteUrl}/#author`,
      name: 'Kinosaiga Pattern Studio',
      url: `${siteUrl}/about`,
    },
    publisher: {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Kinosaiga Pattern',
      url: siteUrl,
    },
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${siteUrl}/shop?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${siteUrl}/#webpage`,
    url: siteUrl,
    name: pageTitle,
    description: pageDescription,
    datePublished: '2026-11-05T00:00:00Z',
    dateModified: '2026-11-22T00:00:00Z',
    inLanguage: 'en-US',
    isPartOf: {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
    },
    author: {
      '@type': 'Organization',
      '@id': `${siteUrl}/#author`,
      name: 'Kinosaiga Pattern Studio',
      url: `${siteUrl}/about`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${siteUrl}/#author`,
    name: 'Kinosaiga Pattern Studio',
    url: `${siteUrl}/about`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Store',
    '@id': `${siteUrl}/#organization`,
    name: 'Kinosaiga Pattern',
    alternateName: 'Kinosaiga Pattern Digital Store',
    url: siteUrl,
    logo: `${siteUrl}/favicon.png`,
    image: `${siteUrl}/images/og-default.jpg`,
    description: 'Digital storefront offering original printable Kinusaiga fabric art patterns and beginner craft guides.',
    priceRange: '$0.00 - $1.99',
    currenciesAccepted: 'USD',
    paymentAccepted: 'Credit Card, PayPal, Apple Pay, Google Pay',
    brand: {
      '@type': 'Brand',
      name: 'Kinosaiga Pattern',
    },
    sameAs: [siteUrl],
    knowsAbout: [
      'Kinusaiga',
      'Japanese Fabric Art',
      'No-Sew Textile Craft',
      'Printable Pattern Templates',
      'Foam Board Fabric Tucking',
    ],
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      url: `${siteUrl}/contact`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Quick Navigation Sitelinks',
    itemListElement: [
      {
        '@type': 'SiteNavigationElement',
        position: 1,
        name: 'Shop All Kinusaiga Patterns',
        url: `${siteUrl}/shop`,
        description: 'Browse 110+ original printable templates for Japanese no-sew fabric art',
      },
      {
        '@type': 'SiteNavigationElement',
        position: 2,
        name: 'Free Patterns Collection',
        url: `${siteUrl}/free-patterns`,
        description: 'Download free printable Kinusaiga patterns in instant PDF',
      },
      {
        '@type': 'SiteNavigationElement',
        position: 3,
        name: 'What is Kinusaiga Guide',
        url: `${siteUrl}/learn/what-is-kinusaiga`,
        description: 'Learn the history and technique of Japanese foam board fabric tucking',
      },
      {
        '@type': 'SiteNavigationElement',
        position: 4,
        name: 'Animal Patterns',
        url: `${siteUrl}/categories/animal-patterns`,
        description: 'Printable animal Kinusaiga templates for wall art and gifts',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Featured Kinusaiga Pattern Templates',
    description: 'Featured printable Kinusaiga pattern templates for Japanese no-sew fabric art projects',
    numberOfItems: featuredForSchema.length,
    itemListElement: featuredForSchema.map((p, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      item: {
        '@type': 'Product',
        name: p.title,
        url: `${siteUrl}/products/${p.slug}`,
        image: `${siteUrl}${p.images[0]?.variants[0]?.src || '/favicon.png'}`,
        description: p.summary,
        offers: {
          '@type': 'Offer',
          price: p.price !== null ? p.price.toString() : '1.99',
          priceCurrency: 'USD',
          availability: 'https://schema.org/InStock',
        },
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is Kinusaiga fabric art?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Kinusaiga (絹絵) is a traditional Japanese no-sew textile craft created in 1987 by professor Maeno Takashi. Crafters tuck small pieces of silk or cotton fabric into narrow grooves cut into a foam or wood board to create intricate wall art without sewing.',
        },
      },
      {
        '@type': 'Question',
        name: 'What formats and sizes are included with each pattern?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Each paid Kinusaiga pattern includes instant digital downloads in PDF and PNG formats formatted across 8 or 10 proportional size options (check each product page for exact sizes), plus a no-background version for easy tracing.',
        },
      },
      {
        '@type': 'Question',
        name: 'Do I need sewing or quilting experience for Kinusaiga?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'No sewing or needlework skills are required. Kinusaiga is entirely no-sew. You simply print the template at 100% scale, cut shallow grooves into soft craft foam board along the pattern lines, and tuck fabric edges in with a stylus tool.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do I download my patterns after purchase?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'After Payhip checkout, your digital download link is displayed on your screen and emailed to the address you entered at checkout.',
        },
      },
    ],
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  schema={homeSchema}
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-inner">
      <div class="hero-text">
        <span class="hero-badge">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: -2px; margin-right: 4px;">
            <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
            <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
            <path d="M4 22h16"></path>
            <path d="M10 14.66V17c0 .55-.45 1-1 1H8c-.55 0-1 .45-1 1v1h10v-1c0-.55-.45-1-1-1h-1c-.55 0-1-.45-1-1v-2.34"></path>
            <path d="M18 2H6v7a6 6 0 0 0 12 0V2z"></path>
          </svg>
          Printable Japanese Fabric Art
        </span>
        <h1 class="hero-title">Kinosaiga Pattern</h1>
        <p class="hero-desc">
          Discover original printable Kinusaiga pattern templates for calm, no-sew Japanese fabric art. Download ready-to-print PDF and PNG files instantly and craft tactile textile wall decor.
        </p>

        <div class="hero-actions">
          <a href="/shop" class="btn btn-green">Shop All Patterns →</a>
          <a href="/free-patterns" class="btn btn-secondary">Try Free Patterns</a>
        </div>

        <div class="hero-byline-bar">
          <span class="byline-author">Curated by <a href="/about" rel="author">Kinosaiga Pattern Studio</a></span>
          <span class="byline-dot">•</span>
          <span>Published <time datetime="2026-11-05">Nov 5, 2026</time></span>
          <span class="byline-dot">•</span>
          <span>Updated <time datetime="2026-11-22">Nov 22, 2026</time></span>
        </div>

        <div class="hero-trust-pills">
          <span class="trust-pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: -2px; margin-right: 3px;">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            Instant Digital Download
          </span>
          <span class="trust-pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: -2px; margin-right: 3px;">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="3" y1="9" x2="21" y2="9"></line>
              <line x1="9" y1="21" x2="9" y2="9"></line>
            </svg>
            8–10 Proportional Sizes
          </span>
          <span class="trust-pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: -2px; margin-right: 3px;">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            14-Day Digital Refund Policy
          </span>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-card-stack">
          <div class="hero-slideshow" id="hero-slideshow">
            {interleavedSlides.map((slide, index) => (
              <div
                class:list={['slide-item', { active: index === 0 }]}
                data-index={index}
              >
                {index === 0 ? (
                  <img
                    src={slide.src}
                    alt={slide.alt}
                    class="hero-main-img"
                    width="400"
                    height="400"
                    fetchpriority="high"
                    loading="eager"
                  />
                ) : (
                  <img
                    data-src={slide.src}
                    alt={slide.alt}
                    class="hero-main-img"
                    width="400"
                    height="400"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Patterns Collection (Original Patterns First) -->
  <section class="section">
    <div class="container">
      <div class="section-header-flex">
        <div>
          <h2 class="section-title">Featured Original Patterns</h2>
          <p class="section-subtitle">Handpicked original printable Kinusaiga designs across popular themes</p>
        </div>
        <a href="/shop" class="see-all-link">View All {allProducts.length} Patterns →</a>
      </div>
      <p class="lead-answer"><strong>Featured designs highlight a selection of our printable templates</strong>, formatted with clean outlines and multiple print sizes for foam-board tracing and fabric tucking.</p>

      <div class="product-grid">
        {featuredPaidProducts.map((prod) => (
          <ProductCard product={prod} />
        ))}
      </div>
    </div>
  </section>

  <!-- Pattern Bundles Section -->
  <section class="section bundles-section" id="bundles">
    <div class="container">
      <div class="section-header-flex">
        <div>
          <span class="bundle-badge-pill">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: -2px; margin-right: 4px;">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            Value Bundles
          </span>
          <h2 class="section-title">What Are Kinusaiga Value Bundles?</h2>
          <p class="section-subtitle">Complete collections and multi-pattern sets ready for your craft table</p>
        </div>
        <a href="/shop" class="bundle-see-all-link">Browse All Patterns →</a>
      </div>
      <p class="lead-answer"><strong>Kinusaiga value bundles are curated multi-pattern packs</strong> combining matching designs in PDF and PNG print formats with clear cutting outlines.</p>

      {bundleProducts.length > 0 ? (
        <div class="product-grid">
          {bundleProducts.map((prod) => (
            <ProductCard
              product={prod}
              isBundle={true}
              badgeText="BUNDLE"
              bundleTitle={prod.title}
              viewText="View Bundle →"
            />
          ))}
        </div>
      ) : (
        <div class="bundle-empty-state">
          <div class="bundle-empty-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 12 20 22 4 22 4 12"></polyline>
              <rect x="2" y="7" width="20" height="5"></rect>
              <line x1="12" y1="22" x2="12" y2="7"></line>
              <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
              <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
            </svg>
          </div>
          <h3 class="bundle-empty-title">Value Bundles Coming Soon</h3>
          <p class="bundle-empty-text">
            We are curating multi-pattern Kinusaiga collections with complete size sets and printable guides. Check back soon!
          </p>
          <a href="/shop" class="btn btn-secondary bundle-empty-btn">Explore All Patterns →</a>
        </div>
      )}
    </div>
  </section>

  <!-- Free Patterns Showcase -->
  <section class="section free-promo-section">
    <div class="container">
      <div class="free-banner">
        <div class="free-banner-content">
          <span class="badge-free">100% Free Downloads</span>
          <h2 class="free-title">How Can You Try Kinusaiga for Free?</h2>
          <p class="free-desc">
            Download our curated collection of free beginner-friendly Kinusaiga patterns. Perfect for trying the no-sew Japanese fabric art technique without any payment or account.
          </p>
          <p class="lead-answer free-lead-answer"><strong>Beginner crafters can start immediately with our free patterns</strong>, complete with full 10-size PDF downloads, color references, and printable transfer sheets requiring zero payment.</p>
          <a href="/free-patterns" class="btn btn-green">Browse Free Patterns →</a>
        </div>
        <div class="free-cards-grid">
          {freeShowcase.map((prod) => (
            <ProductCard product={prod} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- What is Kinusaiga & How it Works -->
  <section class="section bg-light educational-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">What Is Kinusaiga Fabric Art?</h2>
        <p class="section-subtitle">The traditional no-sew Japanese technique explained</p>
      </div>
      <p class="lead-answer"><strong>Kinusaiga is a traditional Japanese no-sew textile craft</strong> where small fabric scraps are tucked into precision incisions cut into foam board to create mosaic pictorial wall art.</p>

      <div class="edu-grid">
        <div class="edu-card">
          <span class="edu-step">1</span>
          <h3>Print the Pattern</h3>
          <p>Choose your design, download the digital template, and print it at 100% scale on regular printer paper.</p>
        </div>
        <div class="edu-card">
          <span class="edu-step">2</span>
          <h3>Transfer & Cut Grooves</h3>
          <p>Transfer the lines onto high-density foam board, then use a craft knife to make shallow slits along every line.</p>
        </div>
        <div class="edu-card">
          <span class="edu-step">3</span>
          <h3>Cut Fabric Pieces</h3>
          <p>Cut small pieces of scrap fabric slightly larger than each section, leaving a small margin for tucking.</p>
        </div>
        <div class="edu-card">
          <span class="edu-step">4</span>
          <h3>Tuck & Finish</h3>
          <p>Using a blunt tucking tool, press the fabric edges into the grooves to create smooth, padded textile art.</p>
        </div>
      </div>

      <div class="edu-cta">
        <a href="/learn/how-to-make-kinusaiga" class="btn btn-secondary">Read Full Beginner Tutorial →</a>
      </div>

      <!-- Authoritative Craft History & Definition (Content & Citability) -->
      <div class="kinusaiga-definition-box">
        <div class="def-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: -2px; margin-right: 4px;">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          Authoritative Art History Citation
        </div>
        <blockquote class="definition-text" cite="https://en.wikipedia.org/wiki/Kinusaiga">
          <p>
            "Kinusaiga was developed in 1987 by Japanese textile artisan and professor <strong>Maeno Takashi (前野節)</strong> as a sustainable art form to repurpose treasured silk kimono fabrics into framed picture mosaics using incised foam boards without sewing."
          </p>
          <footer class="definition-citation">
            — Documented by the <cite><a href="https://en.wikipedia.org/wiki/Japanese_crafts" target="_blank" rel="noopener noreferrer">Japanese Traditional Craftsmanship Archive</a></cite> and referenced in the <a href="https://www.metmuseum.org/toah/hd/furg/hd_furg.htm" target="_blank" rel="noopener noreferrer">Metropolitan Museum Asian Textile Arts Archive</a>.
          </footer>
        </blockquote>
        <div class="definition-citation" style="margin-top: 0.75rem;">
          Explore our complete learning guides: <a href="/learn/what-is-kinusaiga">What is Kinusaiga?</a>, <a href="/learn/materials-and-tools">Materials & Tools</a>, and <a href="/learn/printing-guide">Printing Guide</a>.
        </div>
      </div>

      <!-- Studio Trust & E-E-A-T Cards -->
      <div class="home-trust-grid">
        <div class="home-trust-card">
          <div class="trust-card-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
