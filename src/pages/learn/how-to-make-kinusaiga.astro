    '@id': `${siteUrl}/learn/how-to-make-kinusaiga/#article`,
    headline: 'How to Make Kinusaiga Art: Step-by-Step No-Sew Fabric Craft Tutorial',
    description: 'A complete, practical step-by-step tutorial on making Kinusaiga fabric art. From transferring your printable pattern to cutting grooves and tucking fabric.',
    url: `${siteUrl}/learn/how-to-make-kinusaiga`,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `${siteUrl}/learn/how-to-make-kinusaiga`,
    },
    datePublished: '2026-11-05T00:00:00Z',
    dateModified: '2026-11-09T00:00:00Z',
    author: {
      '@type': 'Organization',
      '@id': `${siteUrl}/#author`,
      name: 'Kinosaiga Pattern Studio',
      url: `${siteUrl}/about`,
    },
    publisher: {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: BRAND_NAME,
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/favicon.png`,
      },
    },
    image: `${siteUrl}/images/og-default.jpg`,
    articleSection: 'Craft Tutorial',
    keywords: 'how to make kinusaiga, japanese fabric art tutorial, no-sew fabric craft, foam board tucking guide',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    '@id': `${siteUrl}/learn/how-to-make-kinusaiga/#howto`,
    name: 'How to Make Kinusaiga Japanese Fabric Art',
    description: 'A complete 7-step guide to crafting authentic Kinusaiga fabric art without any sewing needles or thread.',
    totalTime: 'PT2H',
    estimatedCost: {
      '@type': 'MonetaryAmount',
      currency: 'USD',
      value: '10',
    },
    tool: [
      { '@type': 'HowToTool', name: 'Precision craft knife (30-degree blade)' },
      { '@type': 'HowToTool', name: 'Blunt tucking spatula or wooden stylus' },
      { '@type': 'HowToTool', name: 'Fine fabric embroidery scissors' },
    ],
    supply: [
      { '@type': 'HowToSupply', name: 'High-density XPS foam board (1/2 inch thick)' },
      { '@type': 'HowToSupply', name: 'Assorted woven fabric scraps (cotton or silk)' },
      { '@type': 'HowToSupply', name: 'Printable Kinusaiga pattern PDF' },
      { '@type': 'HowToSupply', name: 'Carbon transfer paper' },
    ],
    step: [
      {
        '@type': 'HowToStep',
        position: 1,
        name: 'Step 1: Choose & Print Your Pattern',
        text: 'Print your Kinusaiga pattern PDF at 100% actual scale on standard paper.',
        url: `${siteUrl}/learn/how-to-make-kinusaiga#step-1`,
      },
      {
        '@type': 'HowToStep',
        position: 2,
        name: 'Step 2: Prepare Your Foam Board',
        text: 'Trim a high-density XPS foam board (10 to 12mm thick) to match pattern frame dimensions.',
        url: `${siteUrl}/learn/how-to-make-kinusaiga#step-2`,
      },
      {
        '@type': 'HowToStep',
        position: 3,
        name: 'Step 3: Transfer the Design',
        text: 'Transfer pattern outlines onto the foam board using graphite carbon paper or light spray adhesive.',
        url: `${siteUrl}/learn/how-to-make-kinusaiga#step-3`,
      },
      {
        '@type': 'HowToStep',
        position: 4,
        name: 'Step 4: Cut Grooves Along the Lines',
        text: 'Score shallow slits 2 to 3mm (1/8 inch) deep along every outline with a sharp craft knife.',
        url: `${siteUrl}/learn/how-to-make-kinusaiga#step-4`,
      },
      {
        '@type': 'HowToStep',
        position: 5,
        name: 'Step 5: Cut Fabric Pieces with a Margin',
        text: 'Cut fabric pieces with a 3 to 4mm seam allowance around the perimeter of each design section.',
        url: `${siteUrl}/learn/how-to-make-kinusaiga#step-5`,
      },
      {
        '@type': 'HowToStep',
        position: 6,
        name: 'Step 6: Tuck Fabric Edges into the Grooves',
        text: 'Gently tuck excess fabric margin into the board channels with a blunt spatula until surface is smooth.',
        url: `${siteUrl}/learn/how-to-make-kinusaiga#step-6`,
      },
      {
        '@type': 'HowToStep',
        position: 7,
        name: 'Step 7: Complete Neighboring Sections & Frame',
