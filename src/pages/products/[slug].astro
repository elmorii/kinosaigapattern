  const wrap = document.getElementById('main-image-wrap') as HTMLElement | null;
  const track = document.getElementById('gallery-slider-track') as HTMLElement | null;
  const thumbBtns = Array.from(document.querySelectorAll('.thumb-btn')) as HTMLButtonElement[];
  const dotBtns = Array.from(document.querySelectorAll('.gallery-dot')) as HTMLButtonElement[];
  const prevBtn = document.getElementById('gallery-prev-btn') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('gallery-next-btn') as HTMLButtonElement | null;
  const thumbContainer = document.querySelector('.thumb-carousel') as HTMLElement | null;

  if (wrap && track && thumbBtns.length > 1) {
    let currentIndex = 0;
    const total = thumbBtns.length;
    let autoInterval: ReturnType<typeof setInterval> | null = null;
    let isManualMode = false;
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let currentDragDelta = 0;
    let isHorizontalGesture: boolean | null = null;
    let wheelCooldown = false;

    function stopAutoSlide() {
      if (autoInterval) {
        clearInterval(autoInterval);
        autoInterval = null;
      }
      isManualMode = true;
    }

    function goToIndex(newIndex: number, manual = false) {
      if (manual) {
        stopAutoSlide();
      }

      currentIndex = (newIndex + total) % total;

      // Update track position with fast, smooth sliding animation
      if (track) {
        track.style.transition = 'transform 0.22s cubic-bezier(0.2, 0.9, 0.4, 1)';
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
      }

      // Update thumbnails and scroll active thumb into view inside container only (without scrolling the page)
      thumbBtns.forEach((btn, idx) => {
        if (idx === currentIndex) {
          btn.classList.add('active');
          if (thumbContainer) {
            const top = btn.offsetTop;
            const bottom = top + btn.offsetHeight;
            if (top < thumbContainer.scrollTop) {
              thumbContainer.scrollTop = top;
            } else if (bottom > thumbContainer.scrollTop + thumbContainer.clientHeight) {
              thumbContainer.scrollTop = bottom - thumbContainer.clientHeight;
            }

            const left = btn.offsetLeft;
            const right = left + btn.offsetWidth;
            if (left < thumbContainer.scrollLeft) {
              thumbContainer.scrollLeft = left;
            } else if (right > thumbContainer.scrollLeft + thumbContainer.clientWidth) {
              thumbContainer.scrollLeft = right - thumbContainer.clientWidth;
            }
          }
        } else {
          btn.classList.remove('active');
        }
      });

      // Update pagination dots
      dotBtns.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    }

    // Fast auto-slide sequence (every 1.6s) until manual user interaction
    function startAutoSlide() {
      if (autoInterval) clearInterval(autoInterval);
      autoInterval = setInterval(() => {
        if (!isManualMode) {
          goToIndex(currentIndex + 1, false);
        }
      }, 1600);
    }

    startAutoSlide();

    // 1. Thumbnail clicks -> manual hand switch
    thumbBtns.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        goToIndex(idx, true);
      });
    });

    // 2. Dot clicks -> manual hand switch
    dotBtns.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        goToIndex(idx, true);
      });
    });

    // 3. Arrow buttons -> manual hand switch
    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        goToIndex(currentIndex - 1, true);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        goToIndex(currentIndex + 1, true);
      });
    }

    // Stop auto-slide if user touches or scrolls thumbnail container
    if (thumbContainer) {
      thumbContainer.addEventListener('touchstart', () => stopAutoSlide(), { passive: true });
      thumbContainer.addEventListener('wheel', () => stopAutoSlide(), { passive: true });
    }

    // 4. Fast scroll between product images (mouse wheel & trackpad scrolling)
    wrap.addEventListener(
      'wheel',
      (e: WheelEvent) => {
        const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
        if (Math.abs(delta) > 3) {
          e.preventDefault();
          stopAutoSlide();
          if (!wheelCooldown) {
            wheelCooldown = true;
            if (delta > 0) {
              goToIndex(currentIndex + 1, true);
            } else {
              goToIndex(currentIndex - 1, true);
            }
            setTimeout(() => {
              wheelCooldown = false;
            }, 110);
          }
        }
      },
      { passive: false }
    );

    // 5. Hand Touch Swipe & Drag (mobile & tablets)
    wrap.addEventListener(
      'touchstart',
      (e: TouchEvent) => {
        if (e.touches.length === 1) {
          stopAutoSlide();
          isDragging = true;
          dragStartX = e.touches[0].clientX;
          dragStartY = e.touches[0].clientY;
          currentDragDelta = 0;
          isHorizontalGesture = null;
          if (track) track.style.transition = 'none';
        }
      },
      { passive: true }
    );

    wrap.addEventListener(
      'touchmove',
      (e: TouchEvent) => {
        if (!isDragging || e.touches.length !== 1 || !track) return;
        const currentX = e.touches[0].clientX;
        const currentY = e.touches[0].clientY;
        const deltaX = currentX - dragStartX;
        const deltaY = currentY - dragStartY;

        if (isHorizontalGesture === null) {
          if (Math.abs(deltaX) > 6 || Math.abs(deltaY) > 6) {
            isHorizontalGesture = Math.abs(deltaX) >= Math.abs(deltaY);
          }
        }

        if (isHorizontalGesture) {
          currentDragDelta = deltaX;
          const currentPercent = -currentIndex * 100;
          track.style.transform = `translateX(calc(${currentPercent}% + ${deltaX}px))`;
        }
      },
      { passive: true }
    );

    const finishTouch = () => {
      if (!isDragging) return;
      isDragging = false;
      if (track) {
        track.style.transition = 'transform 0.22s cubic-bezier(0.2, 0.9, 0.4, 1)';
        if (isHorizontalGesture) {
          if (currentDragDelta < -20) {
            goToIndex(currentIndex + 1, true);
          } else if (currentDragDelta > 20) {
            goToIndex(currentIndex - 1, true);
          } else {
            goToIndex(currentIndex, true);
          }
        } else {
          track.style.transform = `translateX(-${currentIndex * 100}%)`;
        }
      }
      currentDragDelta = 0;
      isHorizontalGesture = null;
    };

    wrap.addEventListener('touchend', finishTouch, { passive: true });
    wrap.addEventListener('touchcancel', finishTouch, { passive: true });

    // 6. Fast Hand Mouse Drag & Slide (desktop)
    let isMouseDown = false;

    wrap.addEventListener('mousedown', (e: MouseEvent) => {
      if ((e.target as HTMLElement).closest('.gallery-nav-btn') || (e.target as HTMLElement).closest('.gallery-dot')) {
        return;
      }
      stopAutoSlide();
      isMouseDown = true;
      wrap.classList.add('is-dragging');
      dragStartX = e.clientX;
      dragStartY = e.clientY;
      currentDragDelta = 0;
      if (track) track.style.transition = 'none';
    });

    window.addEventListener('mousemove', (e: MouseEvent) => {
      if (!isMouseDown || !track) return;
      const deltaX = e.clientX - dragStartX;
      currentDragDelta = deltaX;
      const currentPercent = -currentIndex * 100;
      track.style.transform = `translateX(calc(${currentPercent}% + ${deltaX}px))`;
    });

    window.addEventListener('mouseup', () => {
      if (!isMouseDown) return;
      isMouseDown = false;
      wrap.classList.remove('is-dragging');
      if (track) {
        track.style.transition = 'transform 0.22s cubic-bezier(0.2, 0.9, 0.4, 1)';
        if (currentDragDelta < -20) {
          goToIndex(currentIndex + 1, true);
        } else if (currentDragDelta > 20) {
          goToIndex(currentIndex - 1, true);
        } else {
          goToIndex(currentIndex, true);
        }
      }
      currentDragDelta = 0;
    });
  }
</script>
