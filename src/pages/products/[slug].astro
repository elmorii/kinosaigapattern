---
import Layout from '../../layouts/Layout.astro';
import PurchaseBox from '../../components/PurchaseBox.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getAllProducts, getShopConfig } from '../../lib/catalog.ts';
import type { Product } from '../../lib/types.ts';

export function getStaticPaths() {
  const config = getShopConfig();
  const allProducts = getAllProducts(config.catalog.showDraftsInDev);

  return allProducts.map((product) => {
    // Find related products by same category or similar tags, excluding self (only paid patterns)
    const related = allProducts
      .filter((p) => p.id !== product.id && p.type === 'paid' && (p.category === product.category || p.categorySlug === product.categorySlug))
      .slice(0, 4);

    return {
      params: { slug: product.slug },
      props: { product, related },
    };
  });
}

interface Props {
  product: Product;
  related: Product[];
}

const { product, related } = Astro.props;
const config = getShopConfig();
const mainImg = product.images[0];
const gallery = product.images.slice(1);
const isFree = product.type === 'free';
const isBundle = Boolean(product.isBundle || (product.number >= 113 && product.number <= 119));
const primaryKeyword = isBundle ? `${product.niche} Kinusaiga Bundle` : `Kinusaiga ${product.niche} Pattern`;

// Strictly ONE clean long-tail keyword per product (no slashes, underscores, hyphens, or symbols)
function sanitizeLongTailKeyword(raw: string): string {
  return String(raw || '')
    .replace(/[^a-zA-Z0-9\s]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .toLowerCase();
}

const fallbackLongTail = isBundle
  ? `printable ${product.niche} kinusaiga pattern bundle pdf`
  : isFree
    ? `free printable ${product.niche} kinusaiga pattern pdf`
    : `printable ${product.niche} kinusaiga pattern pdf template`;

const longTailKeyword = sanitizeLongTailKeyword((product.keywords && product.keywords[0]) || fallbackLongTail);
const pageKeywordsList = [longTailKeyword];

// Optimal SEO Meta Title strictly within 40-60 characters
function buildProductTitle(niche: string, isFree: boolean): string {
  const base = isFree
    ? `Free ${niche} Kinusaiga Pattern PDF | Kinosaiga Pattern`
    : `${niche} Kinusaiga Pattern PDF | Kinosaiga Pattern`;
  if (base.length <= 60) return base;
  return isFree
    ? `Free ${niche} Kinusaiga Pattern | Kinosaiga Pattern`
    : `${niche} Kinusaiga Pattern | Kinosaiga Pattern`;
}
const pageTitle = (isBundle && product.seoTitle && product.seoTitle.length <= 70)
  ? product.seoTitle
  : buildProductTitle(product.niche, isFree);

// Optimal SEO Meta Description strictly within 140-160 characters
function buildProductDescription(niche: string, isFree: boolean, sizeCount: number): string {
  if (isFree) {
    let str = `Download free ${niche} Kinusaiga pattern (PDF) for no-sew Japanese fabric art. Print at 100% scale and start creating beautiful wall decor today.`;
    if (str.length >= 140 && str.length <= 160) return str;
    if (str.length < 140) {
      str = `Download free ${niche} Kinusaiga pattern (PDF) for no-sew Japanese fabric art. Print template at 100% scale and start creating beautiful wall decor today.`;
    }
    if (str.length > 160) {
      str = `Download free ${niche} Kinusaiga pattern PDF for no-sew Japanese fabric art. Print template at 100% scale and start creating wall decor today.`;
    }
    return str;
  } else {
    const countText = sizeCount > 0 ? `${sizeCount}` : 'multiple';
    let str = `Printable ${niche} Kinusaiga pattern for no-sew Japanese fabric art. Instant PDF & PNG download with ${countText} size options. Print template and start crafting.`;
    if (str.length >= 140 && str.length <= 160) return str;
    if (str.length < 140) {
      str = `Printable ${niche} Kinusaiga pattern for no-sew Japanese fabric art. Instant PDF and PNG downloads with ${countText} size options. Print template & start crafting.`;
    }
    if (str.length > 160) {
      str = `Printable ${niche} Kinusaiga pattern for no-sew Japanese fabric art. Instant PDF & PNG with ${countText} sizes. Print template and start crafting art today.`;
    }
    return str;
  }
}
const pageDescription = (isBundle && product.metaDescription && product.metaDescription.length >= 130 && product.metaDescription.length <= 165)
  ? product.metaDescription
  : buildProductDescription(product.niche, isFree, product.sizes.length);

// Full Schema.org Knowledge Graph for GEO and AI Search Optimization
const siteUrl = (config.shop.siteUrl || 'https://www.your-domain.com').replace(/\/$/, '');
const fullProductUrl = `${siteUrl}/products/${product.slug}`;
const absoluteImages = product.images.map((img) => {
  const src = img.variants[img.variants.length - 1]?.src || img.variants[0]?.src || '/favicon.png';
  return src.startsWith('http') ? src : `${siteUrl}${src}`;
});

const productSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.title,
    description: pageDescription,
    sku: product.slug,
    mpn: product.slug,
    category: product.category,
    image: absoluteImages,
    datePublished: product.addedAt ? product.addedAt.slice(0, 10) : '2026-11-05',
    dateModified: '2026-11-22',
    brand: {
      '@type': 'Brand',
      name: 'Kinosaiga Pattern',
    },
    manufacturer: {
      '@type': 'Organization',
      name: 'Kinosaiga Pattern',
      url: siteUrl,
    },
    author: {
      '@type': 'Organization',
      '@id': `${siteUrl}/#author`,
      name: 'Kinosaiga Pattern Studio',
      url: `${siteUrl}/about`,
    },
    creator: {
      '@type': 'Organization',
      '@id': `${siteUrl}/#author`,
      name: 'Kinosaiga Pattern Studio',
      url: `${siteUrl}/about`,
    },
    offers: {
      '@type': 'Offer',
      url: fullProductUrl,
      price: product.price !== null ? product.price.toFixed(2) : '0.00',
      priceCurrency: product.currency || 'USD',
      validFrom: (product.addedAt ? product.addedAt.slice(0, 10) : '2026-11-05'),
      priceValidUntil: '2027-12-31',
      itemCondition: 'https://schema.org/NewCondition',
      availability: 'https://schema.org/InStock',
      seller: {
        '@type': 'Organization',
        name: 'Kinosaiga Pattern',
        url: siteUrl,
      },
      hasMerchantReturnPolicy: {
        '@type': 'MerchantReturnPolicy',
        applicableCountry: 'US',
        returnPolicyCountry: 'US',
        returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
        merchantReturnLink: `${siteUrl}/legal/refund-policy`,
      },
      shippingDetails: {
        '@type': 'OfferShippingDetails',
        shippingRate: {
          '@type': 'MonetaryAmount',
          value: '0.00',
          currency: 'USD',
        },
        shippingDestination: {
          '@type': 'DefinedRegion',
          addressCountry: 'US',
        },
        deliveryTime: {
          '@type': 'ShippingDeliveryTime',
          handlingTime: { '@type': 'QuantitativeValue', minValue: 0, maxValue: 0, unitCode: 'DAY' },
          transitTime: { '@type': 'QuantitativeValue', minValue: 0, maxValue: 0, unitCode: 'DAY' },
        },
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${siteUrl}/#author`,
    name: 'Kinosaiga Pattern Studio',
    url: `${siteUrl}/about`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: siteUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Shop',
        item: `${siteUrl}/shop`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: product.category,
        item: `${siteUrl}/categories/${product.categorySlug}`,
      },
      {
        '@type': 'ListItem',
        position: 4,
        name: `${product.niche} Pattern`,
        item: fullProductUrl,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: (product.faq || []).map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    url: fullProductUrl,
    name: pageTitle,
    description: pageDescription,
    isPartOf: {
      '@type': 'WebSite',
      name: config.shop.name || 'Kinusaiga Digital Pattern Store',
      url: siteUrl,
    },
    inLanguage: 'en-US',
    datePublished: product.addedAt || '2026-11-01T00:00:00Z',
    dateModified: product.updatedAt || '2026-11-05T00:00:00Z',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: config.shop.name || 'Kinusaiga Digital Pattern Store',
    url: siteUrl,
    logo: `${siteUrl}/favicon.png`,
    sameAs: [siteUrl],
    knowsAbout: [
      'Kinusaiga',
      'Japanese Fabric Art',
      'No-Sew Textile Craft',
      'Printable Fabric Templates',
      'Kinusaiga Pattern Design',
    ],
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  exactKeywords={longTailKeyword}
  ogImage={product.ogImage || mainImg?.variants?.[0]?.src}
  schema={productSchema}
>
  <div class="container product-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href="/shop">Shop</a>
      <span class="sep">/</span>
      <a href={`/categories/${product.categorySlug}`}>{product.category}</a>
      <span class="sep">/</span>
      <span class="current">{product.niche}</span>
    </nav>

    <!-- Top Product Showcase -->
    <div class="product-top-grid">
      <!-- Image Gallery -->
      <div class="gallery-col">
        <div class="gallery-inner">
          {gallery.length > 0 && (
            <div class="thumb-carousel" aria-label="Product thumbnails">
              {product.images.map((img, i) => (
                <button
                  class:list={['thumb-btn', { active: i === 0 }]}
                  data-src={img.variants.find((v) => v.width >= 800)?.src || img.variants[0]?.src}
                  data-alt={img.alt}
                  aria-label={`View image ${i + 1}`}
                >
                  <img
                    src={img.variants[0]?.src}
                    alt={`Thumbnail ${i + 1}`}
                    width="80"
                    height="80"
                    class="thumb-img"
                  />
                </button>
              ))}
            </div>
          )}

          <div class="main-image-wrap" id="main-image-wrap" aria-roledescription="carousel">
            <div class="gallery-slider-track" id="gallery-slider-track">
              {product.images.map((img, i) => {
                const src800 = img.variants.find((v) => v.width >= 800)?.src || img.variants[0]?.src;
                return (
                  <div class="gallery-slide" data-slide-index={i}>
                    <img
                      src={src800}
                      alt={img.alt || `${product.title} - View ${i + 1}`}
                      width="800"
                      height="800"
                      class="main-img"
                      loading={i === 0 ? "eager" : "lazy"}
                      decoding={i === 0 ? "sync" : "async"}
                      draggable="false"
                    />
                  </div>
                );
              })}
            </div>
            {gallery.length > 0 && (
              <>
                <button
                  type="button"
                  class="gallery-nav-btn prev-btn"
                  id="gallery-prev-btn"
                  aria-label="Previous image"
                >
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"></polyline>
                  </svg>
                </button>
                <button
                  type="button"
                  class="gallery-nav-btn next-btn"
                  id="gallery-next-btn"
                  aria-label="Next image"
                >
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </button>
                <div class="gallery-dots" id="gallery-dots" role="tablist" aria-label="Image indicators">
                  {product.images.map((_, i) => (
                    <button
                      type="button"
                      class:list={['gallery-dot', { active: i === 0 }]}
                      data-dot-index={i}
                      aria-label={`Jump to image ${i + 1}`}
                    ></button>
                  ))}
                </div>
              </>
            )}
          </div>
        </div>

        <!-- Quick Specs moved directly under the image gallery -->
        <div class="quick-specs" aria-label="Template Specifications">
          <dl class="quick-specs-dl">
            <div class="spec-row">
              <dt class="spec-label">Format:</dt>
              <dd class="spec-val">
                {product.formats.length > 0 ? product.formats.join(', ') : 'PDF, PNG'}
                {product.noBackgroundVersion && <span class="spec-extra"> (Plus No-Background Version)</span>}
              </dd>
            </div>
            <div class="spec-row">
              <dt class="spec-label">Pattern:</dt>
              <dd class="spec-val">Kinusaiga {product.niche} Pattern</dd>
            </div>
            <div class="spec-row">
              <dt class="spec-label">Craft Type:</dt>
              <dd class="spec-val">Kinusaiga (No-sew Japanese fabric art)</dd>
            </div>
            <div class="spec-row">
              <dt class="spec-label">Skill Level:</dt>
              <dd class="spec-val">Beginner to Experienced Crafters</dd>
            </div>
            <div class="spec-row">
              <dt class="spec-label">Delivery:</dt>
              <dd class="spec-val">Instant digital download (PDF format)</dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Product Buy / Summary -->
      <div class="details-col">
        <div class="product-header">
          <div class="product-tags-row">
            <span class="product-badge">{product.category}</span>
            <span class="product-keyword-pill">{isBundle ? 'Kinusaiga Patterns Bundle' : `Kinusaiga ${product.niche} Pattern`}</span>
          </div>

          <h1 class="product-h1">{isBundle ? `${product.niche} Kinusaiga Bundle – Printable Kinusaiga Patterns Collection` : `${product.niche} Kinusaiga Pattern – Kinusaiga ${product.niche} Pattern Printable Template`}</h1>

          <div class="product-byline-bar">
            <span class="byline-author">Designed by <a href="/about" rel="author">Kinosaiga Pattern Studio</a></span>
            <span class="byline-sep">•</span>
            <span class="byline-date">Published <time datetime={product.addedAt ? product.addedAt.slice(0, 10) : '2026-11-05'}>{product.addedAt ? product.addedAt.slice(0, 10) : 'Nov 5, 2026'}</time></span>
            <span class="byline-sep">•</span>
            <span class="byline-updated">Updated <time datetime="2026-11-22">Nov 22, 2026</time></span>
          </div>
        </div>

        <p class="product-summary">{product.summary}</p>

        <!-- Purchase / Download Component -->
        <PurchaseBox product={product} />
      </div>
    </div>

    <!-- Long Details & Content Sections -->
    <div class="product-details-content">
      <div class="content-tabs">
        <!-- AI & GEO Citability: Quick Overview Summary Box -->
        <div class="ai-key-takeaways" aria-label="Key Pattern Summary">
          <div class="takeaways-header">
            <span class="takeaways-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </span>
            <strong>Quick Overview · Pattern Key Facts</strong>
          </div>
          <ul class="takeaways-list">
            <li><strong>Design:</strong> Printable {product.niche} Kinusaiga pattern template.</li>
            <li><strong>Craft Technique:</strong> Japanese no-sew fabric tucking on foam or wood board.</li>
            <li><strong>Format:</strong> Instant digital download in PDF and PNG formats.</li>
            <li><strong>Sizes Included:</strong> {product.sizes.length > 0 ? `${product.sizes.length} proportional size options` : 'Multiple print sizes for home and shop printers'}.</li>
            <li><strong>Experience Level:</strong> Beginner-friendly to advanced textile crafters.</li>
            <li><strong>Refund Policy:</strong> 14-day refund eligibility for duplicate purchases, unresolvable defective files, or description errors (<a href="/legal/refund-policy">Refund Policy</a>).</li>
          </ul>
        </div>

        <section class="desc-section">
          <h2>{isBundle ? `What Makes This ${product.niche} Kinusaiga Bundle Unique?` : `What Makes This ${product.niche} Kinusaiga Pattern Unique?`}</h2>
          <p class="lead-answer"><strong>This {product.niche} {isBundle ? 'Kinusaiga bundle is a comprehensive printable collection of templates for Japanese no-sew fabric art' : 'Kinusaiga pattern is a printable template for Japanese no-sew fabric art'}</strong>, formatted with clean outlines for tracing or transferring onto foam board before cutting grooves and tucking fabric.</p>
          <p class="pattern-keyword-highlight">
            Featured Design: <strong>{isBundle ? `${product.niche} Kinusaiga Bundle` : `Kinusaiga ${product.niche} Pattern`}</strong>
          </p>
          {product.description.overview.map((p) => (
            <p>{p}</p>
          ))}

          {isBundle && (
            <div class="bundle-seo-callout" style="margin-top: 1.25rem; padding: 1.25rem; background: #fdf2f8; border: 1px solid #fbcfe8; border-radius: 8px;">
              <h3 style="margin-top: 0; font-size: 1.1rem; color: #831843;">Complete Kinusaiga Patterns Bundle &amp; Templates Collection</h3>
              <p style="margin-bottom: 0; line-height: 1.7; color: #374151;">
                Looking for a comprehensive <strong>kinusaiga bundle</strong>? Our curated <strong>kinusaiga patterns bundle</strong> provides an extensive collection of authentic <strong>kinusaiga patterns</strong> and ready-to-use <strong>kinusaiga templates</strong> designed for Japanese no-sew fabric craft. With this all-in-one <strong>kinusaiga template bundle</strong>, you receive an instant <strong>kinusaiga patterns download</strong> featuring crisp <strong>printable kinusaiga patterns</strong> in convenient <strong>kinusaiga patterns pdf</strong> and high-resolution PNG formats. Whether you want <strong>kinusaiga patterns printable</strong> for personal crafting or gifting handmade wall art, each design offers clean grooving lines and numbered fabric placement guides.
              </p>
            </div>
          )}

          <!-- Authoritative Definition & Citation Block for AI Search & Content Citability -->
          <div class="kinusaiga-definition-box">
            <div class="definition-title">
              <span class="def-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: -2px; margin-right: 4px;">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
                Authoritative Craft History Citation
              </span>
            </div>
            <blockquote class="definition-text" cite="https://en.wikipedia.org/wiki/Kinusaiga">
              <p>
                "Kinusaiga was developed in 1987 by Japanese textile artisan and professor <strong>Maeno Takashi (前野節)</strong> as an art form to repurpose vintage kimono silk fabrics into intricate mosaic pictures using incised foam boards without sewing."
              </p>
              <footer class="citation-footer">
                — Documented by the <cite><a href="https://en.wikipedia.org/wiki/Japanese_crafts" target="_blank" rel="noopener noreferrer">Japanese Traditional Craftsmanship Archive</a></cite> and referenced in the <a href="https://www.metmuseum.org/toah/hd/furg/hd_furg.htm" target="_blank" rel="noopener noreferrer">Metropolitan Museum Asian Textile Arts Archive</a>.
              </footer>
            </blockquote>
            <div class="definition-citation" style="margin-top: 0.75rem;">
              Want to master the craft? Explore our <a href="/learn/what-is-kinusaiga">Complete Guide to Kinusaiga Art</a> and <a href="/learn/how-to-make-kinusaiga">Step-by-Step Beginner Tutorial</a>.
            </div>
          </div>
        </section>

        {product.description.included.length > 0 && (
          <section class="desc-section">
            <h2>{isBundle ? `What Is Included in This ${product.niche} Kinusaiga Bundle?` : `What Is Included in This Kinusaiga ${product.niche} Pattern?`}</h2>
            <p class="lead-answer"><strong>Each {product.niche} digital package includes {product.sizes.length > 0 ? `${product.sizes.length} pre-scaled` : 'printable'} PDF and PNG templates</strong>, a no-background version, and instant digital delivery.</p>
            <ul class="styled-list">
              {product.description.included.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )}

        {product.sizes.length > 0 && (
          <section class="desc-section">
            <h2>{isBundle ? `What Sizes Are Included in This ${product.niche} Bundle?` : `What Sizes Are Included in This ${product.niche} Pattern Package?`}</h2>
            <p class="lead-answer"><strong>Every design comes pre-scaled across {product.sizes.length} distinct frame dimensions</strong>, ensuring you can print immediately on standard letter or A4 printers without distortion.</p>
            <p class="sizes-intro">
              This listing includes templates formatted for {product.sizes.length} distinct project sizes:
            </p>
            <ul class="styled-list sizes-list">
              {product.sizes.map((s) => (
                <li>
                  <strong>{s.label}</strong> {s.cm && `(${s.cm})`} – {s.ratio} aspect ratio
                </li>
              ))}
            </ul>
          </section>
        )}

        {product.description.features.length > 0 && (
          <section class="desc-section">
            <h2>{isBundle ? `What Are the Key Features of This ${product.niche} Kinusaiga Bundle?` : `What Are the Key Features of This ${product.niche} Pattern?`}</h2>
            <p class="lead-answer"><strong>This digital package provides clean printable lines in PDF and PNG formats</strong>, scaled across {product.sizes.length > 0 ? `${product.sizes.length} sizes` : 'standard sizes'} for home or print-shop printing.</p>
            <ul class="styled-list">
              {product.description.features.map((feat) => (
                <li>{feat}</li>
              ))}
            </ul>
          </section>
        )}

        <section class="desc-section">
          <h2>How Do You Download & Access Your {product.niche} Pattern Files?</h2>
          <p class="lead-answer"><strong>{isFree ? 'Your free pattern PDF downloads directly in your browser' : 'Your pattern files are delivered immediately after Payhip checkout'}</strong>{isFree ? ' without payment or account registration.' : ' via download link on screen and in your confirmation email.'}</p>
          <ol class="styled-ol">
            {product.description.access.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </section>

        <section class="desc-section">
          <h2>What Materials Do You Need for This {product.niche} Project?</h2>
          <p class="lead-answer"><strong>To craft this design, you only need high-density foam board, scrap fabrics, a craft blade, and a tucking stylus</strong>—no sewing machine, thread, or glue required.</p>
          <ul class="styled-list">
            {product.description.important.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>

        <!-- Studio & File Format Overview Card -->
        <section class="desc-section eeat-verification-section">
          <h2>Pattern Specifications & Digital File Overview</h2>
          <div class="artisan-profile-card">
            <div class="artisan-badge">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
                <path d="M2 12h20"></path>
              </svg>
            </div>
            <div class="artisan-content">
              <div class="artisan-header-row">
                <div>
                  <h3 class="artisan-name">Kinosaiga Pattern Studio</h3>
                  <span class="artisan-role">Printable Kinusaiga Digital Templates · kinosaigapattern.com</span>
                </div>
                <span class="verification-pill">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="display: inline-block; vertical-align: -1px; margin-right: 3px;">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  Digital Files
                </span>
              </div>
              <p class="artisan-statement">
