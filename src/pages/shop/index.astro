<script>
  const searchInput = document.getElementById('filter-search') as HTMLInputElement;
  const clearSearchBtn = document.getElementById('clear-search-btn') as HTMLButtonElement;
  let currentCategory = 'all';
  const sortSelect = document.getElementById('filter-sort') as HTMLSelectElement;
  const grid = document.getElementById('product-grid') as HTMLElement;
  const emptyState = document.getElementById('empty-state') as HTMLElement;
  const resultsCount = document.getElementById('results-count') as HTMLElement;
  const resetBtn = document.getElementById('reset-filters') as HTMLButtonElement;
  const chipButtons = Array.from(document.querySelectorAll('.chip-btn')) as HTMLButtonElement[];

  // Pagination Elements (Bottom only)
  const paginationBottom = document.getElementById('pagination-bottom') as HTMLElement;
  const pageNavBottom = document.getElementById('pagination-nav-bottom') as HTMLElement;
  const pageSummaryBottom = document.getElementById('page-summary-bottom') as HTMLElement;
  const perPageSelectBottom = document.getElementById('per-page-select-bottom') as HTMLSelectElement;

  // Tags meta elements
  const activeTagsWrap = document.getElementById('active-tags-wrap') as HTMLElement;
  const tagCategory = document.getElementById('tag-category') as HTMLElement;
  const tagCategoryText = document.getElementById('tag-category-text') as HTMLElement;
  const removeTagCat = document.getElementById('remove-tag-cat') as HTMLButtonElement;
  const tagSearch = document.getElementById('tag-search') as HTMLElement;
  const tagSearchText = document.getElementById('tag-search-text') as HTMLElement;
  const removeTagSearch = document.getElementById('remove-tag-search') as HTMLButtonElement;
  const resetAllTags = document.getElementById('reset-all-tags') as HTMLButtonElement;

  // Pagination & Filter State
  const DEFAULT_PER_PAGE = 60;
  const VALID_PER_PAGE_LIMITS = [10, 15, 20, 60, 100, 200];
  let perPage = DEFAULT_PER_PAGE;
  let currentPage = 1;
  let totalPages = 1;
  const allItems = Array.from(grid.querySelectorAll('.product-item')) as HTMLElement[];
  let filteredItems: HTMLElement[] = [...allItems];

  // Remove initial-hidden classes from SSR
  allItems.forEach((item) => item.classList.remove('initial-hidden'));

  // Handle URL query parameters
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('type') === 'free') {
    window.location.replace('/free-patterns');
  }
  if (urlParams.has('q')) {
    searchInput.value = urlParams.get('q') || '';
  }
  if (urlParams.has('category')) {
    currentCategory = urlParams.get('category') || 'all';
  }
  if (urlParams.get('type') === 'new') {
    sortSelect.value = 'id-desc';
  }
  if (urlParams.has('limit')) {
    const lim = Number(urlParams.get('limit'));
    if (VALID_PER_PAGE_LIMITS.includes(lim)) {
      perPage = lim;
    }
  }
  if (urlParams.has('page')) {
    const p = Number(urlParams.get('page'));
    if (p >= 1) {
      currentPage = p;
    }
  }
  if (perPageSelectBottom) perPageSelectBottom.value = String(perPage);

  function syncChips(catSlug: string) {
    chipButtons.forEach((chip) => {
      const chipCat = chip.dataset.cat;
      if (chipCat === catSlug) {
        chip.classList.add('active');
        chip.scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' });
      } else {
        chip.classList.remove('active');
      }
    });
  }

  function renderPaginationButtons(container: HTMLElement) {
    if (!container) return;
    container.innerHTML = '';
    if (totalPages <= 1) {
      container.style.display = 'none';
      return;
    }
    container.style.display = 'flex';

    // Previous Button
    const prevBtn = document.createElement('button');
    prevBtn.type = 'button';
    prevBtn.className = 'page-btn page-btn-prev';
    prevBtn.innerHTML = `
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align: -1px; margin-right: 2px;">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      Prev
    `;
    prevBtn.disabled = currentPage <= 1;
    prevBtn.setAttribute('aria-label', 'Previous page');
    prevBtn.addEventListener('click', () => {
      if (currentPage > 1) goToPage(currentPage - 1);
    });
    container.appendChild(prevBtn);

    // Number Buttons calculation
    const pages: (number | string)[] = [];
    if (totalPages <= 7) {
      for (let i = 1; i <= totalPages; i++) pages.push(i);
    } else {
      pages.push(1);
      if (currentPage > 3) {
        pages.push('...');
      }
      const start = Math.max(2, currentPage - 1);
      const end = Math.min(totalPages - 1, currentPage + 1);
      for (let i = start; i <= end; i++) {
        if (i > 1 && i < totalPages) {
          pages.push(i);
        }
      }
      if (currentPage < totalPages - 2) {
        pages.push('...');
      }
      pages.push(totalPages);
    }

    pages.forEach((p) => {
      if (p === '...') {
        const span = document.createElement('span');
        span.className = 'page-ellipsis';
        span.textContent = '…';
        span.setAttribute('aria-hidden', 'true');
        container.appendChild(span);
      } else {
        const pageNum = p as number;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `page-btn page-btn-num ${pageNum === currentPage ? 'active' : ''}`;
        btn.textContent = String(pageNum);
        btn.setAttribute('aria-label', `Page ${pageNum}`);
        if (pageNum === currentPage) {
          btn.setAttribute('aria-current', 'page');
        } else {
          btn.addEventListener('click', () => goToPage(pageNum));
        }
        container.appendChild(btn);
      }
    });

    // Next Button
    const nextBtn = document.createElement('button');
    nextBtn.type = 'button';
    nextBtn.className = 'page-btn page-btn-next';
    nextBtn.innerHTML = `
      Next
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align: -1px; margin-left: 2px;">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    `;
    nextBtn.disabled = currentPage >= totalPages;
    nextBtn.setAttribute('aria-label', 'Next page');
    nextBtn.addEventListener('click', () => {
      if (currentPage < totalPages) goToPage(currentPage + 1);
    });
    container.appendChild(nextBtn);
  }

  function renderCurrentPage(smoothScroll = false) {
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    const startIdx = (currentPage - 1) * perPage;
    const endIdx = startIdx + perPage;

    // Hide all items first
    allItems.forEach((item) => {
      item.style.display = 'none';
    });

    // Show only the current page's slice from filteredItems
    filteredItems.forEach((item, index) => {
      if (index >= startIdx && index < endIdx) {
        item.style.display = '';
      }
    });

    // Empty state & results count handling
    if (filteredItems.length === 0) {
      grid.style.display = 'none';
      emptyState.style.display = 'block';
      if (paginationBottom) paginationBottom.style.display = 'none';
      resultsCount.innerHTML = `Showing <strong>0</strong> patterns`;
    } else {
      grid.style.display = 'grid';
      emptyState.style.display = 'none';
      if (paginationBottom) paginationBottom.style.display = 'flex';

      const fromNum = startIdx + 1;
      const toNum = Math.min(endIdx, filteredItems.length);
      resultsCount.innerHTML = `Showing <strong>${fromNum}–${toNum}</strong> of <strong>${filteredItems.length}</strong> patterns`;
    }

    // Update Bottom Page Summary
    if (pageSummaryBottom) {
      pageSummaryBottom.innerHTML = `Page <strong>${currentPage}</strong> of <strong>${totalPages}</strong>`;
    }

    // Render Navigation Buttons
    if (pageNavBottom) renderPaginationButtons(pageNavBottom);

    // Sync Per-Page Selector
    if (perPageSelectBottom) perPageSelectBottom.value = String(perPage);

    // Smooth scroll to catalog top anchor if requested
    if (smoothScroll) {
      const anchor = document.getElementById('catalog-top-anchor');
      if (anchor) {
        const top = anchor.getBoundingClientRect().top + window.scrollY - 85;
        window.scrollTo({ top, behavior: 'smooth' });
      }
    }

    // Persist page & limit & category to URL without reloading
    const newParams = new URLSearchParams(window.location.search);
    if (currentPage > 1) {
      newParams.set('page', String(currentPage));
    } else {
      newParams.delete('page');
    }
    if (perPage !== DEFAULT_PER_PAGE) {
      newParams.set('limit', String(perPage));
    } else {
      newParams.delete('limit');
    }
    if (currentCategory !== 'all') {
      newParams.set('category', currentCategory);
    } else {
      newParams.delete('category');
    }
    const newUrl = `${window.location.pathname}${newParams.toString() ? '?' + newParams.toString() : ''}`;
    window.history.replaceState({}, '', newUrl);
  }

  function goToPage(pageNum: number) {
    currentPage = pageNum;
    renderCurrentPage(true);
  }

  function handlePerPageChange(newVal: string) {
    const val = Number(newVal);
    if (VALID_PER_PAGE_LIMITS.includes(val)) {
      perPage = val;
      currentPage = 1;
      totalPages = Math.max(1, Math.ceil(filteredItems.length / perPage));
      renderCurrentPage(true);
    }
  }

  if (perPageSelectBottom) {
    perPageSelectBottom.addEventListener('change', (e) => {
      handlePerPageChange((e.target as HTMLSelectElement).value);
    });
  }

  function filterAndSort(resetPage = true) {
    const query = searchInput.value.toLowerCase().trim();
    const cat = currentCategory;
    const sort = sortSelect.value;

    if (clearSearchBtn) {
      clearSearchBtn.style.display = searchInput.value ? 'flex' : 'none';
    }

    // Match query & category
    filteredItems = allItems.filter((item) => {
      const id = item.dataset.id || '';
      const name = item.dataset.name || '';
      const niche = item.dataset.niche || '';
      const itemCat = item.dataset.category || '';

      const matchesQuery = !query || id.includes(query) || name.includes(query) || niche.includes(query);
      const matchesCat = cat === 'all' || itemCat === cat;
      return matchesQuery && matchesCat;
    });

    // Sort items
    filteredItems.sort((a, b) => {
      if (sort === 'id-asc') return Number(a.dataset.number) - Number(b.dataset.number);
      if (sort === 'id-desc') return Number(b.dataset.number) - Number(a.dataset.number);
      if (sort === 'name') return (a.dataset.name || '').localeCompare(b.dataset.name || '');
      if (sort === 'price-asc') return Number(a.dataset.price) - Number(b.dataset.price);
      return 0;
    });

    filteredItems.forEach((item) => grid.appendChild(item));

    totalPages = Math.max(1, Math.ceil(filteredItems.length / perPage));

    if (resetPage) {
      currentPage = 1;
    }

    // Update Active Filter Tags
    let hasActiveFilters = false;
    if (cat !== 'all') {
      hasActiveFilters = true;
      tagCategory.style.display = 'inline-flex';
      const activeChip = chipButtons.find((btn) => btn.dataset.cat === cat);
      tagCategoryText.textContent = activeChip ? (activeChip.textContent || '').replace(/\s*\d+$/, '').trim() : cat;
    } else {
      tagCategory.style.display = 'none';
    }

    if (query) {
      hasActiveFilters = true;
      tagSearch.style.display = 'inline-flex';
      tagSearchText.textContent = query;
    } else {
      tagSearch.style.display = 'none';
    }

    activeTagsWrap.style.display = hasActiveFilters ? 'flex' : 'none';

    renderCurrentPage(false);
  }

  // Chip buttons click listener
  chipButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetCat = btn.dataset.cat || 'all';
      currentCategory = targetCat;
      syncChips(targetCat);
      filterAndSort(true);
    });
  });

  // Search input listeners
  searchInput.addEventListener('input', () => filterAndSort(true));
  if (clearSearchBtn) {
    clearSearchBtn.addEventListener('click', () => {
      searchInput.value = '';
      searchInput.focus();
      filterAndSort(true);
    });
  }

  // Sort listener
  sortSelect.addEventListener('change', () => filterAndSort(true));

  // Remove tag listeners
  removeTagCat.addEventListener('click', () => {
    currentCategory = 'all';
    syncChips('all');
    filterAndSort(true);
  });
  removeTagSearch.addEventListener('click', () => {
    searchInput.value = '';
    filterAndSort(true);
  });

  // Reset buttons
  function resetAll() {
    searchInput.value = '';
    currentCategory = 'all';
    sortSelect.value = 'id-desc';
    perPage = DEFAULT_PER_PAGE;
    currentPage = 1;
    syncChips('all');
    filterAndSort(true);
  }

  if (resetBtn) resetBtn.addEventListener('click', resetAll);
  if (resetAllTags) resetAllTags.addEventListener('click', resetAll);

  // Initial sync & filter without resetting page
  syncChips(currentCategory);
  filterAndSort(false);
</script>
