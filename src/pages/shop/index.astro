---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getAllProducts, getCategories, getShopConfig } from '../../lib/catalog.ts';

const config = getShopConfig();
const paidProducts = getAllProducts(config.catalog.showDraftsInDev)
  .filter((p) => p.type === 'paid')
  .sort((a, b) => b.number - a.number);
const categories = getCategories();
const siteUrl = config.shop.siteUrl || 'https://kinusaigapattern.com';

const shopSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${siteUrl}/shop/#collection`,
  name: 'Shop All Printable Kinusaiga Patterns | Kinusaiga Pattern',
  description: 'Browse our complete collection of 110+ printable Kinusaiga fabric art patterns. Instant digital PDF and PNG downloads for no-sew Japanese textile art.',
  url: `${siteUrl}/shop`,
  datePublished: '2026-11-05T00:00:00Z',
  dateModified: '2026-11-09T18:00:00Z',
  inLanguage: 'en',
  author: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#author`,
    name: 'Kinusaiga Pattern Studio',
    url: `${siteUrl}/about`,
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: 'Kinusaiga Pattern',
    url: siteUrl,
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: paidProducts.length,
    itemListElement: paidProducts.slice(0, 30).map((p, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      item: {
        '@type': 'Product',
        name: p.title,
        url: `${siteUrl}/products/${p.slug}`,
        image: `${siteUrl}${p.images[0]?.variants[0]?.src || '/favicon.png'}`,
        description: p.summary,
        offers: {
          '@type': 'Offer',
          price: p.price !== null ? p.price.toString() : '1.99',
          priceCurrency: 'USD',
          availability: 'https://schema.org/InStock',
        },
      },
    })),
  },
};

const shopFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${siteUrl}/shop/#faq`,
  name: 'Kinusaiga Patterns Frequently Asked Questions & Buying Guide',
  url: `${siteUrl}/shop`,
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What Are Kinusaiga Pattern Templates & How Do They Work?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Kinusaiga pattern templates are printable vector outlines engineered for no-sew Japanese fabric art, allowing crafters to transfer numbered contours onto high-density foam boards, incise 2–3mm grooves, and tuck fabric edges smoothly with a stylus.',
      },
    },
    {
      '@type': 'Question',
      name: 'How Do You Choose the Best Kinusaiga Pattern for Beginners?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Beginners should select patterns with larger individual pieces and gentle curves—such as bold animal silhouettes, single flower blossoms, or simple objects—before advancing to multi-piece landscapes or fine architectural motifs.',
      },
    },
    {
      '@type': 'Question',
      name: 'What File Formats and Scaled Sizes Are Included with Each Purchase?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Every pattern download includes PDF and PNG files pre-scaled across 8 or 10 standard frame dimensions (listed on each pattern page), calibrated to print at 100% actual size without distortion on standard home printers.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which Materials and Tools Do You Need to Complete a Pattern?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'You only need 4 basic household crafting supplies to complete any Kinusaiga project: a sheet of 1/2-inch high-density XPS foam board, woven fabric scraps (quilting cotton or linen), a precision craft knife, and a blunt tucking stylus.',
      },
    },
  ],
};
---

<Layout
  title="Shop All Printable Kinusaiga Patterns | Kinusaiga Pattern"
  description="Browse our complete collection of 110+ printable Kinusaiga fabric art patterns. Instant digital PDF and PNG downloads for no-sew Japanese textile art."
  schema={[shopSchema, shopFaqSchema]}
>
  <!-- Upgraded Shop Hero Section -->
  <section class="shop-hero">
    <div class="container shop-hero-inner">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>Authentic Japanese Fabric Art Collection</span>
      </div>

      <h1 class="shop-title">
        Shop All <span class="highlight">Kinusaiga Patterns</span>
      </h1>
    </div>
  </section>

  <div class="container shop-container">
    <!-- Upgraded Modern Filter Card -->
    <div class="filter-card">
      <div class="filter-controls-row">
        <!-- Search Input with Embedded Icon & Clear Button -->
        <div class="search-wrap">
          <svg class="search-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="text"
            id="filter-search"
            placeholder="Search"
            class="search-field"
            autocomplete="off"
            aria-label="Search"
          />
          <button type="button" id="clear-search-btn" class="clear-btn" aria-label="Clear search" style="display: none;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <!-- Filter Selects -->
        <div class="selects-wrap">
          <div class="custom-select-box">
            <svg class="select-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="21 8 21 21 3 21 3 8"></polyline>
              <line x1="10" y1="12" x2="14" y2="12"></line>
            </svg>
            <select id="filter-sort" class="styled-select" aria-label="Sort patterns">
              <option value="id-desc" selected>Newest First</option>
              <option value="id-asc">Catalog Order</option>
              <option value="name">Name (A–Z)</option>
              <option value="price-asc">Price (Low to High)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Quick Category Chips Bar -->
      <div class="category-chips-bar" aria-label="Category Filters">
        <button type="button" class="chip-btn active" data-cat="all">
          All <span class="chip-count">{paidProducts.length}</span>
        </button>
        {categories.map((c) => (
          <button type="button" class="chip-btn" data-cat={c.slug}>
            {c.name.replace(' Patterns', '').replace(' Pattern', '')}
            <span class="chip-count">{c.count}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Active Filters & Counter Meta Bar -->
    <div class="results-bar">
      <div class="counter-wrap">
        <span class="live-dot"></span>
        <span id="results-count">Showing <strong>{paidProducts.length}</strong> patterns</span>
      </div>

      <div id="active-tags-wrap" class="active-tags" style="display: none;">
        <span class="tag-chip" id="tag-category" style="display: none;">
          Category: <strong id="tag-category-text"></strong>
          <button type="button" id="remove-tag-cat" class="tag-x" aria-label="Remove category filter">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </span>
        <span class="tag-chip" id="tag-search" style="display: none;">
          Search: "<strong id="tag-search-text"></strong>"
          <button type="button" id="remove-tag-search" class="tag-x" aria-label="Remove search filter">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </span>
        <button type="button" id="reset-all-tags" class="reset-link">Reset all</button>
      </div>
    </div>

    <!-- Anchor for Smooth Pagination Scrolling -->
    <div id="catalog-top-anchor" style="scroll-margin-top: 110px;"></div>

    <!-- Product Grid Section with Proper Heading Hierarchy -->
    <section class="catalog-section" aria-label="Kinusaiga Pattern Catalog">
      <h2 class="sr-only">Available Kinusaiga Pattern Templates</h2>

      <div class="product-grid" id="product-grid">
        {paidProducts.map((prod, idx) => (
          <div
            class:list={['product-item', { 'initial-hidden': idx >= 60 }]}
            data-id={prod.id.toLowerCase()}
            data-name={prod.title.toLowerCase()}
            data-niche={prod.niche.toLowerCase()}
            data-category={prod.categorySlug}
            data-type={prod.type}
            data-number={prod.number}
            data-price={prod.price !== null ? prod.price : 0}
          >
            <ProductCard product={prod} />
          </div>
        ))}
      </div>

      <div id="empty-state" class="empty-state" style="display: none;">
        <div class="empty-icon-wrap">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <h3 class="empty-title">No matching patterns found</h3>
        <p>Try searching for a different keyword or reset your category filters to view all designs.</p>
        <button id="reset-filters" class="btn btn-green">Reset Filters</button>
      </div>

      <!-- Bottom Pagination & Per-Page Controls Bar -->
      <div class="pagination-bar pagination-bar-bottom" id="pagination-bottom" aria-label="Bottom Catalog Pagination">
        <div class="pagination-info">
          <span id="page-summary-bottom" class="page-summary">Page 1 of {Math.ceil(paidProducts.length / 60)}</span>
        </div>

        <div class="pagination-nav" id="pagination-nav-bottom"></div>

        <div class="per-page-control">
          <label for="per-page-select-bottom" class="per-page-label">Show:</label>
          <div class="custom-select-box per-page-box">
            <select id="per-page-select-bottom" class="styled-select per-page-select" aria-label="Products per page (bottom)">
              <option value="10">10</option>
              <option value="15">15</option>
              <option value="20">20</option>
              <option value="60" selected>60</option>
              <option value="100">100</option>
              <option value="200">200</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Trust & Feature Badges Moved Directly Under Pagination Navigation -->
      <div class="feature-strip feature-strip-bottom" aria-label="Customer Trust & Guarantees">
        <div class="feature-item">
          <svg class="feat-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Instant Download (PDF & PNG)</span>
        </div>
        <div class="feature-item">
          <svg class="feat-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="3" y1="9" x2="21" y2="9"></line>
            <line x1="9" y1="21" x2="9" y2="9"></line>
          </svg>
          <span>8–10 Proportional Frame Sizes</span>
        </div>
        <div class="feature-item">
          <svg class="feat-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="6" cy="6" r="3"></circle>
            <circle cx="6" cy="18" r="3"></circle>
            <line x1="20" y1="4" x2="8.12" y2="15.88"></line>
            <line x1="14.47" y1="14.48" x2="20" y2="20"></line>
            <line x1="8.12" y1="8.12" x2="12" y2="12"></line>
          </svg>
          <span>100% No-Sew Technique</span>
        </div>
        <div class="feature-item">
          <svg class="feat-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>14-Day Refund Policy</span>
        </div>
      </div>
    </section>

    <!-- Moved Answer-First Definition & E-E-A-T Byline Section to Page Bottom -->
    <div class="shop-bottom-definition-wrap">
      <div class="shop-answer-first" aria-label="Pattern Collection Definition">
        <p class="lead-answer">
          <strong>Kinusaiga patterns are printable full-scale Japanese fabric art templates</strong> formatted for no-sew textile tucking onto high-density foam boards. Our collection provides nearly 300 paid digital PDF and PNG designs pre-scaled across 8 or 10 frame sizes with clear cutting outlines for craft creation.
        </p>
      </div>

      <!-- Visible Machine-Readable Byline for E-E-A-T and Citability -->
      <div class="shop-byline-bar" aria-label="Catalog Provenance">
        <span class="byline-author">Curated by <a href="/about" rel="author">Kinusaiga Pattern Studio</a></span>
        <span class="byline-sep">•</span>
        <span class="byline-date">Published <time datetime="2026-11-05">Nov 5, 2026</time></span>
        <span class="byline-sep">•</span>
        <span class="byline-updated">Updated <time datetime="2026-11-09">Nov 9, 2026</time></span>
      </div>
    </div>

    <!-- Craft Collection Standards Citation -->
    <div class="kinusaiga-definition-box" style="margin: 4.5rem 0 2.5rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem;">
      <div class="def-badge" style="display: inline-flex; align-items: center; gap: 4px; background: #e0f2fe; color: #0369a1; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; padding: 0.2rem 0.6rem; border-radius: 999px; margin-bottom: 0.6rem;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
        </svg>
        Japanese Textile Craft Collection
      </div>
      <blockquote class="definition-text" cite="https://en.wikipedia.org/wiki/Japanese_crafts" style="margin: 0; color: #1e293b; line-height: 1.65;">
        <p>
          "Kinusaiga art represents a unique fusion of mosaic geometry and tactile silk craft, allowing crafters worldwide to assemble intricate wall art without needle or thread."
        </p>
        <footer class="citation-footer" style="margin-top: 0.6rem; font-size: 0.85rem; color: #64748b;">
          — Curated according to Japanese craft heritage documented by the <cite><a href="https://en.wikipedia.org/wiki/Japanese_crafts" target="_blank" rel="noopener noreferrer" style="color: #2563eb; text-decoration: underline;">Japanese Traditional Craftsmanship Archive</a></cite> and preserved in the <a href="https://americanart.si.edu/art/craft" target="_blank" rel="noopener noreferrer" style="color: #2563eb; text-decoration: underline;">Smithsonian American Art Museum Craft Archive</a>.
        </footer>
      </blockquote>
    </div>

    <!-- Educational & Buying Guide Section with Question-Style Headings and Answer-First Structure -->
    <section class="shop-info-section" aria-label="Kinusaiga Patterns Buying & Crafting Guide">
      <div class="shop-info-block">
        <h2 class="info-question">What Are Kinusaiga Pattern Templates & How Do They Work?</h2>
        <p class="lead-answer">
          <strong>Kinusaiga pattern templates are printable vector outlines engineered for no-sew Japanese fabric art</strong>, allowing crafters to transfer numbered contours onto high-density foam boards, incise 2–3mm grooves, and tuck fabric edges smoothly with a stylus.
        </p>
        <p>
          Unlike traditional patchwork, embroidery, or needlepoint, Kinusaiga requires no sewing needles, sewing machines, or messy adhesives. The foam groove provides gentle mechanical friction that holds fabric margins firmly in place, creating a dimensional, tactile mosaic effect.
        </p>
      </div>

      <div class="shop-info-block">
        <h2 class="info-question">How Do You Choose the Best Kinusaiga Pattern for Beginners?</h2>
        <p class="lead-answer">
          <strong>Beginners should select patterns with larger individual pieces and gentle curves</strong>—such as bold animal silhouettes, single flower blossoms, or simple objects—before advancing to multi-piece landscapes or fine architectural motifs.
        </p>
        <p>
          Our shop categorizes patterns by subject (animals, nature, flowers, ordinary objects) and provides 8 or 10 pre-scaled sizes per download (listed on each product page), so you can start on smaller 5×5 or 8×8 inch frames for manageable craft results.
        </p>
      </div>

      <div class="shop-info-block">
        <h2 class="info-question">What File Formats and Scaled Sizes Are Included with Each Purchase?</h2>
        <p class="lead-answer">
          <strong>Every pattern download includes PDF and PNG files pre-scaled across 8 or 10 standard frame dimensions</strong>, calibrated to print at 100% actual size without distortion on standard home printers.
        </p>
        <p>
          You receive instant digital download links directly via Payhip after checkout, accompanied by no-background outline versions ready for your craft workspace.
        </p>
      </div>

      <div class="shop-info-block">
        <h2 class="info-question">Which Materials and Tools Do You Need to Complete a Pattern?</h2>
        <p class="lead-answer">
          <strong>You only need 4 basic household crafting supplies to complete any Kinusaiga project</strong>: a sheet of 1/2-inch high-density XPS foam board, woven fabric scraps (quilting cotton or linen), a precision craft knife, and a blunt tucking stylus.
        </p>
        <p>
          For comprehensive instructions on tools and blade angles, explore our free step-by-step <a href="/learn/materials-and-tools">Materials & Tools Guide</a> and <a href="/learn/how-to-make-kinusaiga">Kinusaiga Tutorial</a>.
        </p>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Hero Section */
  .shop-hero {
    background: linear-gradient(180deg, #eff6ff 0%, #f8fafc 100%);
    border-bottom: 1px solid var(--border-subtle);
    padding: 2.75rem 0 2rem;
    text-align: center;
    position: relative;
    width: 100%;
  }
  .shop-hero-inner {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(37, 99, 235, 0.12);
    border: 1px solid rgba(37, 99, 235, 0.3);
    color: #1d4ed8;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.35rem 0.9rem;
    border-radius: 9999px;
    margin-bottom: 0.85rem;
  }
  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2563eb;
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.25);
  }
  .shop-title {
    font-size: clamp(2.1rem, 4vw, 2.9rem);
    font-weight: 800;
    color: #0f172a;
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .shop-title .highlight {
    color: var(--cta-green);
    position: relative;
    display: inline-block;
  }
  .shop-answer-first {
    max-width: 840px;
    margin: 0 auto 1.25rem;
    padding: 0 1rem;
    text-align: center;
  }
  .shop-answer-first .lead-answer {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #334155;
    margin: 0;
  }
  .shop-answer-first .lead-answer strong {
    color: #1e40af;
    font-weight: 700;
  }
  .shop-byline-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #64748b;
    margin: 0 auto 1.75rem;
    flex-wrap: wrap;
  }
  .shop-byline-bar a {
    color: var(--cta-green);
    text-decoration: underline;
    font-weight: 600;
  }
  .shop-byline-bar .byline-sep {
    color: #cbd5e1;
  }
  .shop-subtitle {
    font-size: 1.15rem;
    color: #475569;
    line-height: 1.5;
    margin: 0 auto 2rem;
    width: 100%;
    max-width: 100%;
    text-align: center;
    white-space: nowrap;
  }
  .feature-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 100%;
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.25rem 2.2rem;
    margin: 2rem 0 1.5rem;
    box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.04), 0 2px 4px -1px rgba(15, 23, 42, 0.02);
  }
  .feature-item {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #1e293b;
    white-space: nowrap;
  }
  .feat-icon {
    color: var(--cta-green);
    flex-shrink: 0;
  }

  /* Main Shop Layout */
  .shop-container {
    padding-top: 1.75rem;
    padding-bottom: 5rem;
  }

  /* Modern Filter Card */
  .filter-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.25rem 1.4rem;
    box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.05), 0 2px 6px -1px rgba(15, 23, 42, 0.03);
    margin-bottom: 1.5rem;
  }
  .filter-controls-row {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .search-wrap {
    flex: 1 1 auto;
    min-width: 240px;
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-svg {
    position: absolute;
    left: 1rem;
    color: #94a3b8;
    pointer-events: none;
  }
  .search-field {
    width: 100%;
    padding: 0.78rem 2.4rem 0.78rem 2.85rem;
    border: 1.5px solid #cbd5e1;
    border-radius: 10px;
    font-size: 0.95rem;
    background: #f8fafc;
    color: #0f172a;
    transition: all 0.2s ease;
    outline: none;
  }
  .search-field:focus {
    background: #ffffff;
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }
  .clear-btn {
    position: absolute;
    right: 0.8rem;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #e2e8f0;
    border: none;
    color: #64748b;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }
